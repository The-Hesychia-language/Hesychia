# json: JSON text to values and back (RFC 8259).

import io
from io import File, IoError, print, stdout

# A JSON value. Objects keep their keys in the order they were read or added.
manual enum Value:
    Null
    Bool(flag: bool)
    Number(number: f64)
    Text(text: str)
    List(items: vector[Value])
    Object(fields: dict[str, Value])

# Bytes cut from valid text at ASCII marks, or built from code points, are valid text.
priv manual fn text_of(bytes: &vector[u8]) -> str:
    const text: Optional[str] = str.from_bytes(bytes)
    if text is None:
        panic("json: not UTF-8 text")
    return text

# Text that is not well-formed JSON, and where it goes wrong, in bytes.
manual struct JsonError:
    at: size
    reason: str

priv manual fn error(at: size, reason: &str) -> JsonError:
    return JsonError(at=at, reason=f"{reason}")

priv manual fn skip_space(text: &str, at: &mut size):
    while at < byte_len(text) and (text.byte(at) == 32 or text.byte(at) == 9 or text.byte(at) == 10 or text.byte(at) == 13):
        at += 1

priv manual fn expect_word(text: &str, at: &mut size, word: &str) raises JsonError:
    for i in range(byte_len(word)):
        if at + i >= byte_len(text) or text.byte(at + i) != word.byte(i):
            raise error(at, f"expected `{word}`")
    at += byte_len(word)

priv manual fn hex_digit(b: u8) -> Optional[u32]:
    if b >= 48 and b <= 57:
        return u32(b - 48)
    if b >= 97 and b <= 102:
        return u32(b - 87)
    if b >= 65 and b <= 70:
        return u32(b - 55)
    return None

# The four hex digits of a `\u` escape.
priv manual fn code_unit(text: &str, at: &mut size) -> u32 raises JsonError:
    mut value: u32 = 0
    for _ in range(4):
        if at >= byte_len(text):
            raise error(at, "a `\\u` escape needs four hex digits")
        const digit: Optional[u32] = hex_digit(text.byte(at))
        if digit is None:
            raise error(at, "a `\\u` escape needs four hex digits")
        value = value * 16 + digit
        at += 1
    return value

priv manual fn push_utf8(out: &mut vector[u8], code: u32):
    if code < 128:
        out.push(u8(code))
    elif code < 2048:
        out.push(u8(192 | (code >> 6)))
        out.push(u8(128 | (code & 63)))
    elif code < 65536:
        out.push(u8(224 | (code >> 12)))
        out.push(u8(128 | ((code >> 6) & 63)))
        out.push(u8(128 | (code & 63)))
    else:
        out.push(u8(240 | (code >> 18)))
        out.push(u8(128 | ((code >> 12) & 63)))
        out.push(u8(128 | ((code >> 6) & 63)))
        out.push(u8(128 | (code & 63)))

# A string, from its opening quote.
priv manual fn read_text(text: &str, at: &mut size) -> str raises JsonError:
    at += 1
    mut out: vector[u8] = []
    while at < byte_len(text) and text.byte(at) != 34:
        const b: u8 = text.byte(at)
        if b < 32:
            raise error(at, "a control character inside a string")
        if b != 92:
            out.push(b)
            at += 1
        else:
            at += 1
            if at >= byte_len(text):
                raise error(at, "a string is not closed")
            const escape: u8 = text.byte(at)
            at += 1
            if escape == 34 or escape == 92 or escape == 47:
                out.push(escape)
            elif escape == 98:
                out.push(8)
            elif escape == 102:
                out.push(12)
            elif escape == 110:
                out.push(10)
            elif escape == 114:
                out.push(13)
            elif escape == 116:
                out.push(9)
            elif escape == 117:
                mut code: u32 = check code_unit(text, at)
                # A pair of surrogates stands for one character beyond U+FFFF.
                if code >= 55296 and code < 56320:
                    check expect_word(text, at, "\\u")
                    const low: u32 = check code_unit(text, at)
                    if low < 56320 or low >= 57344:
                        raise error(at, "a lone surrogate in a `\\u` escape")
                    code = 65536 + ((code - 55296) << 10) + (low - 56320)
                elif code >= 56320 and code < 57344:
                    raise error(at, "a lone surrogate in a `\\u` escape")
                push_utf8(&mut out, code)
            else:
                raise error(at - 1, "an unknown escape")
    if at >= byte_len(text):
        raise error(at, "a string is not closed")
    at += 1
    return text_of(&out)

priv manual fn is_digit(b: u8) -> bool:
    return b >= 48 and b <= 57

priv manual fn read_number(text: &str, at: &mut size) -> f64 raises JsonError:
    const start: size = at
    const n: size = byte_len(text)
    if at < n and text.byte(at) == 45:
        at += 1
    if at >= n or not is_digit(text.byte(at)):
        raise error(start, "expected a value")
    if text.byte(at) == 48:
        at += 1
    else:
        while at < n and is_digit(text.byte(at)):
            at += 1
    if at < n and text.byte(at) == 46:
        at += 1
        if at >= n or not is_digit(text.byte(at)):
            raise error(at, "expected digits after the point")
        while at < n and is_digit(text.byte(at)):
            at += 1
    if at < n and (text.byte(at) == 101 or text.byte(at) == 69):
        at += 1
        if at < n and (text.byte(at) == 43 or text.byte(at) == 45):
            at += 1
        if at >= n or not is_digit(text.byte(at)):
            raise error(at, "expected digits in the exponent")
        while at < n and is_digit(text.byte(at)):
            at += 1
    const digits: str = text[start:at]
    try:
        return check f64(digits)
    except ParseError as _e:
        raise error(start, "not a number")

priv manual fn read_value(text: &str, at: &mut size, depth: size) -> Value raises JsonError:
    if depth > 512:
        raise error(at, "values nested too deeply")
    skip_space(text, at)
    if at >= byte_len(text):
        raise error(at, "expected a value")
    const b: u8 = text.byte(at)
    if b == 110:
        check expect_word(text, at, "null")
        return Value.Null
    if b == 116:
        check expect_word(text, at, "true")
        return Value.Bool(True)
    if b == 102:
        check expect_word(text, at, "false")
        return Value.Bool(False)
    if b == 34:
        return Value.Text(check read_text(text, at))
    if b == 91:
        at += 1
        mut items: vector[Value] = []
        skip_space(text, at)
        if at < byte_len(text) and text.byte(at) == 93:
            at += 1
            return Value.List(items)
        mut more: bool = True
        while more:
            items.push(check read_value(text, at, depth + 1))
            skip_space(text, at)
            if at < byte_len(text) and text.byte(at) == 44:
                at += 1
            elif at < byte_len(text) and text.byte(at) == 93:
                at += 1
                more = False
            else:
                raise error(at, "expected `,` or `]`")
        return Value.List(items)
    if b == 123:
        at += 1
        mut fields: dict[str, Value] = dict()
        skip_space(text, at)
        if at < byte_len(text) and text.byte(at) == 125:
            at += 1
            return Value.Object(fields)
        mut more: bool = True
        while more:
            skip_space(text, at)
            if at >= byte_len(text) or text.byte(at) != 34:
                raise error(at, "expected a key in quotes")
            const key: str = check read_text(text, at)
            skip_space(text, at)
            if at >= byte_len(text) or text.byte(at) != 58:
                raise error(at, "expected `:`")
            at += 1
            fields[key] = check read_value(text, at, depth + 1)
            skip_space(text, at)
            if at < byte_len(text) and text.byte(at) == 44:
                at += 1
            elif at < byte_len(text) and text.byte(at) == 125:
                at += 1
                more = False
            else:
                raise error(at, "expected `,` or `}`")
        return Value.Object(fields)
    return Value.Number(check read_number(text, at))

# The value written in `text`.
manual fn parse(text: &str) -> Value raises JsonError:
    mut at: size = 0
    const value: Value = check read_value(text, &mut at, 0)
    skip_space(text, &mut at)
    if at != byte_len(text):
        raise error(at, "text after the value")
    return value

priv manual fn dump_text(out: &mut str, text: &str):
    out += "\""
    mut bytes: vector[u8] = []
    for i in range(byte_len(text)):
        const b: u8 = text.byte(i)
        if b == 34 or b == 92:
            bytes.push(92)
            bytes.push(b)
        elif b == 10:
            bytes.push(92)
            bytes.push(110)
        elif b == 13:
            bytes.push(92)
            bytes.push(114)
        elif b == 9:
            bytes.push(92)
            bytes.push(116)
        elif b < 32:
            const digits: str = "0123456789abcdef"
            const escape: str = "\\u00"
            for i in range(byte_len(escape)):
                bytes.push(escape.byte(i))
            bytes.push(digits.byte(size(b >> 4)))
            bytes.push(digits.byte(size(b & 15)))
        else:
            bytes.push(b)
    out += text_of(&bytes)
    out += "\""

# A line break and `depth` levels of `indent` spaces, when `indent` asks for lines.
priv manual fn new_line(out: &mut str, indent: size, depth: size):
    if indent == 0:
        return
    out += "\n"
    for _ in range(indent * depth):
        out += " "

priv manual fn dump_into(out: &mut str, value: &Value, indent: size, depth: size):
    match value:
        case Value.Null:
            out += "null"
        case Value.Bool(flag):
            if flag:
                out += "true"
            else:
                out += "false"
        case Value.Number(number):
            # Integers are written without a point, as JSON writers usually do.
            if number == f64(i64(number)) and number < 9007199254740992.0 and number > -9007199254740992.0:
                out += f"{i64(number)}"
            else:
                out += f"{number}"
        case Value.Text(text):
            dump_text(out, text)
        case Value.List(items):
            out += "["
            for i in range(len(items)):
                if i > 0:
                    out += ","
                new_line(out, indent, depth + 1)
                dump_into(out, &items[i], indent, depth + 1)
            if len(items) > 0:
                new_line(out, indent, depth)
            out += "]"
        case Value.Object(fields):
            out += "{"
            mut first: bool = True
            for key, item in fields.items():
                if not first:
                    out += ","
                first = False
                new_line(out, indent, depth + 1)
                dump_text(out, &key)
                out += ":"
                if indent > 0:
                    out += " "
                dump_into(out, &item, indent, depth + 1)
            if len(fields) > 0:
                new_line(out, indent, depth)
            out += "}"

# --- structs ---------------------------------------------------------------------------
# A struct is read from an object, and written as one: each field from the key of its name.
# A field can be a text, a number, a `bool`, a struct, a `vector`, a `dict` from texts, an
# `Optional` of them (absent or `null` is `None`), or a `Value`. Keys that name no field are
# passed over.

priv comptime fn is_int(T: type) -> bool:
    return T == i8 or T == i16 or T == i32 or T == i64 or T == u8 or T == u16 or T == u32 or T == u64 or T == size

# What a value of the wrong kind raises. Its reason starts with where it is, which each
# level adds in front as the error goes up: ".address.zip: expected a text".
priv manual fn refused(reason: &str) -> JsonError:
    return JsonError(at=0, reason=f": {reason}")

priv manual fn within(e: &JsonError, part: &str) -> JsonError:
    return JsonError(at=e.at, reason=f"{part}{e.reason}")

priv manual fn is_optional[T](_slot: &T) -> bool:
    comptime if T == Optional:
        return True
    else:
        return False

# Sets `out` from `value`.
priv manual fn fill[T](out: &mut T, value: &Value) raises JsonError:
    comptime if T == Value:
        out = value.copy()
    elif T == str:
        match value:
            case Value.Text(text):
                out = text.copy()
            case _:
                raise refused("expected a text")
    elif T == bool:
        match value:
            case Value.Bool(flag):
                out = flag
            case _:
                raise refused("expected true or false")
    elif T == f64:
        match value:
            case Value.Number(number):
                out = number
            case _:
                raise refused("expected a number")
    elif T == f32:
        match value:
            case Value.Number(number):
                out = f32(number)
            case _:
                raise refused("expected a number")
    elif is_int(T):
        match value:
            case Value.Number(number):
                if number > 9007199254740992.0 or number < -9007199254740992.0 or number != f64(i64(number)):
                    raise refused("expected a whole number")
                const fit: Optional[T] = T.checked(i64(number))
                if fit is None:
                    raise refused(f"{i64(number)} does not fit the field's type")
                out = fit
            case _:
                raise refused("expected a number")
    elif T == Optional:
        match value:
            case Value.Null:
                out = None
            case _:
                mut one: item(T) = empty[item(T)]()
                check fill(&mut one, value)
                out = one
    elif T == vector:
        match value:
            case Value.List(items):
                out.clear()
                for i in range(len(items)):
                    mut one: item(T) = empty[item(T)]()
                    try:
                        check fill(&mut one, &items[i])
                    except JsonError as e:
                        raise within(&e, f"[{i}]")
                    out.push(one)
            case _:
                raise refused("expected a list")
    elif T == dict:
        match value:
            case Value.Object(entries):
                out.clear()
                const names: vector[str] = entries.keys()
                for name in &names:
                    mut one: item(T) = empty[item(T)]()
                    try:
                        check fill(&mut one, &entries[name])
                    except JsonError as e:
                        raise within(&e, f".{name}")
                    out[name.copy()] = one
            case _:
                raise refused("expected an object")
    elif is_struct(T):
        match value:
            case Value.Object(entries):
                comptime for f in fields(T):
                    if f.name in entries:
                        try:
                            check fill(&mut field(out, f), &entries[f.name])
                        except JsonError as e:
                            raise within(&e, f".{f.name}")
                    elif not is_optional(&field(out, f)):
                        raise JsonError(at=0, reason=f".{f.name}: missing")
            case _:
                raise refused("expected an object")
    else:
        comptime assert(False, "json reads texts, numbers, `bool`, structs, `vector`, `dict`, `Optional` and `Value`")

# `text` read as a `T`: `json.to_struct[User](text)` for a struct, or
# `json.to_struct[vector[User]](text)` for a list of them. What does not fit raises a
# `JsonError` whose reason says where: "users[2].age: expected a number".
manual fn to_struct[T](text: &str) -> T raises JsonError:
    const value: Value = check parse(text)
    mut out: T = empty[T]()
    try:
        check fill(&mut out, &value)
    except JsonError as e:
        # The reason starts with ".name" or ": ": the mark in front goes.
        if e.reason.starts_with(": "):
            raise JsonError(at=e.at, reason=e.reason[2:])
        if e.reason.starts_with("."):
            raise JsonError(at=e.at, reason=e.reason[1:])
        raise e
    return out

# What is written in the file: a `Value`, or with `json.load[User](f)` a `User`, read as
# `to_struct` reads it.
manual fn load[T = Value](f: &File) -> T raises JsonError | IoError:
    const text: Optional[str] = check io.read(f, end="")
    if text is None:
        raise error(0, "expected a value")
    comptime if T == Value:
        return check parse(&text)
    else:
        return check to_struct[T](&text)

# `x` as a `Value`.
priv manual fn to_value[T](x: &T) -> Value:
    comptime if T == Value:
        return x.copy()
    elif T == str:
        return Value.Text(x.copy())
    elif T == bool:
        return Value.Bool(x)
    elif T == f64 or T == f32 or is_int(T):
        return Value.Number(f64(x))
    elif T == Optional:
        const held: T = x.copy()
        if held is None:
            return Value.Null
        return to_value(&held)
    elif T == vector:
        mut items: vector[Value] = []
        for i in range(len(x)):
            items.push(to_value(&x[i]))
        return Value.List(items)
    elif T == dict:
        mut entries: dict[str, Value] = dict()
        const names: vector[str] = x.keys()
        for name in &names:
            entries[name.copy()] = to_value(&x[name])
        return Value.Object(entries)
    elif is_struct(T):
        mut entries: dict[str, Value] = dict()
        comptime for f in fields(T):
            entries[f.name] = to_value(&field(x, f))
        return Value.Object(entries)
    else:
        comptime assert(False, "json writes texts, numbers, `bool`, structs, `vector`, `dict`, `Optional` and `Value`")

# `value` as JSON text: on one line, or with `indent` spaces per level. `value` is a
# `Value`, or anything `to_struct` reads.
manual fn to_text[T](value: &T, indent: size = 0) -> str:
    mut out: str = ""
    comptime if T == Value:
        dump_into(&mut out, value, indent, 0)
    else:
        const made: Value = to_value(value)
        dump_into(&mut out, &made, indent, 0)
    return out

# Writes `value` as JSON, as `to_text` gives it.
manual fn dump[T](value: &T, to: &File = stdout, indent: size = 0):
    print(to_text(value, indent), to=to)

# json: JSON text to values and back (RFC 8259).

import io
import scan
from io import File, IoError, print, stdout
from scan import Class, Scanner, ScanError

# A JSON value. Objects keep their keys in the order they were read or added.
manual enum Value:
    Null
    Bool(flag: bool)
    Number(number: f64)
    Text(text: str)
    List(items: vector[Value])
    Object(fields: dict[str, Value])

# Text that is not well-formed JSON, or a value that does not fit a struct. `line` and
# `column` say where the text goes wrong, counted from 1 in characters; both are 0 when it
# is the value that does not fit, and `reason` then starts with where: "users[2].age: ...".
manual struct JsonError:
    line: size
    column: size
    reason: str

# The error at `at`, a mark of `s`.
priv manual fn error(s: &Scanner, at: size, reason: &str) -> JsonError:
    const e: ScanError = s.error_at(at, reason)
    return JsonError(line=e.line, column=e.column, reason=e.reason.copy())

# Takes `word`, the whole of `null`, `true` or `false`.
priv manual fn expect_word(s: &mut Scanner, word: &str) raises JsonError:
    if not s.eat(word):
        raise error(s, s.mark(), f"expected `{word}`")

# The four hex digits of a `\u` escape.
priv manual fn code_unit(s: &mut Scanner) -> u32 raises JsonError:
    const at: size = s.mark()
    mut digits: str = ""
    for _ in range(4):
        if s.next_is("\"") or s.at_end():
            raise error(s, at, "a `\\u` escape needs four hex digits")
        digits += s.next()
    try:
        return check u32(digits, base=16)
    except ParseError as _e:
        raise error(s, at, "a `\\u` escape needs four hex digits")

priv manual fn push_utf8(out: &mut vector[u8], code: u32):
    if code < 128:
        out.push(u8(code))
    elif code < 2048:
        out.push(u8(192 | (code >> 6)))
        out.push(u8(128 | (code & 63)))
    elif code < 65536:
        out.push(u8(224 | (code >> 12)))
        out.push(u8(128 | ((code >> 6) & 63)))
        out.push(u8(128 | (code & 63)))
    else:
        out.push(u8(240 | (code >> 18)))
        out.push(u8(128 | ((code >> 12) & 63)))
        out.push(u8(128 | ((code >> 6) & 63)))
        out.push(u8(128 | (code & 63)))

# A string, from its opening quote.
priv manual fn read_text(s: &mut Scanner) -> str raises JsonError:
    s.next()
    mut out: vector[u8] = []
    while True:
        const start: size = s.mark()
        const piece: str = s.take_except("\"\\")
        const bytes: vector[u8] = piece.bytes()
        for i in range(len(bytes)):
            if bytes[i] < 32:
                raise error(s, start + i, "a control character inside a string")
        out.extend(bytes)
        if s.eat("\""):
            return str.from_any_bytes(&out)
        if s.at_end():
            raise error(s, s.mark(), "a string is not closed")
        s.next()
        const at: size = s.mark()
        const escape: str = s.next()
        if escape == "\"" or escape == "\\" or escape == "/":
            out.extend(escape.bytes())
        elif escape == "b":
            out.push(8)
        elif escape == "f":
            out.push(12)
        elif escape == "n":
            out.push(10)
        elif escape == "r":
            out.push(13)
        elif escape == "t":
            out.push(9)
        elif escape == "u":
            mut code: u32 = check code_unit(s)
            # A pair of surrogates stands for one character beyond U+FFFF.
            if code >= 55296 and code < 56320:
                check expect_word(s, "\\u")
                const low: u32 = check code_unit(s)
                if low < 56320 or low >= 57344:
                    raise error(s, s.mark(), "a lone surrogate in a `\\u` escape")
                code = 65536 + ((code - 55296) << 10) + (low - 56320)
            elif code >= 56320 and code < 57344:
                raise error(s, s.mark(), "a lone surrogate in a `\\u` escape")
            push_utf8(&mut out, code)
        elif escape == "":
            raise error(s, at, "a string is not closed")
        else:
            raise error(s, at, "an unknown escape")
    return ""

priv manual fn read_number(s: &mut Scanner) -> f64 raises JsonError:
    const start: size = s.mark()
    s.eat("-")
    const digits: str = s.take_while(Class.Digit)
    if byte_len(digits) == 0:
        raise error(s, start, "expected a value")
    if byte_len(digits) > 1 and digits.starts_with("0"):
        raise error(s, start, "a number does not start with `0` and another digit")
    if s.eat("."):
        if byte_len(s.take_while(Class.Digit)) == 0:
            raise error(s, s.mark(), "expected digits after the point")
    if s.eat("e") or s.eat("E"):
        if not s.eat("+"):
            s.eat("-")
        if byte_len(s.take_while(Class.Digit)) == 0:
            raise error(s, s.mark(), "expected digits in the exponent")
    const digits_text: str = s.since(start)
    try:
        return check f64(digits_text)
    except ParseError as _e:
        raise error(s, start, "not a number")

priv manual fn read_value(s: &mut Scanner, depth: size) -> Value raises JsonError:
    if depth > 512:
        raise error(s, s.mark(), "values nested too deeply")
    s.skip_space()
    if s.at_end():
        raise error(s, s.mark(), "expected a value")
    if s.next_is("n"):
        check expect_word(s, "null")
        return Value.Null
    if s.next_is("t"):
        check expect_word(s, "true")
        return Value.Bool(True)
    if s.next_is("f"):
        check expect_word(s, "false")
        return Value.Bool(False)
    if s.next_is("\""):
        return Value.Text(check read_text(s))
    if s.eat("["):
        mut items: vector[Value] = []
        s.skip_space()
        if s.eat("]"):
            return Value.List(items)
        while True:
            items.push(check read_value(s, depth + 1))
            s.skip_space()
            if s.eat("]"):
                return Value.List(items)
            if not s.eat(","):
                raise error(s, s.mark(), "expected `,` or `]`")
    if s.eat("{"):
        mut fields: dict[str, Value] = dict()
        s.skip_space()
        if s.eat("}"):
            return Value.Object(fields)
        while True:
            s.skip_space()
            if not s.next_is("\""):
                raise error(s, s.mark(), "expected a key in quotes")
            const key: str = check read_text(s)
            s.skip_space()
            if not s.eat(":"):
                raise error(s, s.mark(), "expected `:`")
            fields[key] = check read_value(s, depth + 1)
            s.skip_space()
            if s.eat("}"):
                return Value.Object(fields)
            if not s.eat(","):
                raise error(s, s.mark(), "expected `,` or `}`")
    return Value.Number(check read_number(s))

# The value written in `text`.
priv manual fn parse_value(text: &str) -> Value raises JsonError:
    mut s: Scanner = scan.over(text)
    const value: Value = check read_value(&mut s, 0)
    s.skip_space()
    if not s.at_end():
        raise error(&s, s.mark(), "text after the value")
    return value

priv manual fn dump_text(out: &mut str, text: &str):
    out += "\""
    mut bytes: vector[u8] = []
    for i in range(byte_len(text)):
        const b: u8 = text.byte(i)
        if b == 34 or b == 92:
            bytes.push(92)
            bytes.push(b)
        elif b == 10:
            bytes.push(92)
            bytes.push(110)
        elif b == 13:
            bytes.push(92)
            bytes.push(114)
        elif b == 9:
            bytes.push(92)
            bytes.push(116)
        elif b < 32:
            const digits: str = "0123456789abcdef"
            const escape: str = "\\u00"
            for i in range(byte_len(escape)):
                bytes.push(escape.byte(i))
            bytes.push(digits.byte(size(b >> 4)))
            bytes.push(digits.byte(size(b & 15)))
        else:
            bytes.push(b)
    out += str.from_any_bytes(&bytes)
    out += "\""

# A line break and `depth` levels of `indent` spaces, when `indent` asks for lines.
priv manual fn new_line(out: &mut str, indent: size, depth: size):
    if indent == 0:
        return
    out += "\n"
    for _ in range(indent * depth):
        out += " "

priv manual fn dump_into(out: &mut str, value: &Value, indent: size, depth: size):
    match value:
        case Value.Null:
            out += "null"
        case Value.Bool(flag):
            if flag:
                out += "true"
            else:
                out += "false"
        case Value.Number(number):
            # Integers are written without a point, as JSON writers usually do.
            if number == f64(i64(number)) and number < 9007199254740992.0 and number > -9007199254740992.0:
                out += f"{i64(number)}"
            else:
                out += f"{number}"
        case Value.Text(text):
            dump_text(out, text)
        case Value.List(items):
            out += "["
            for i in range(len(items)):
                if i > 0:
                    out += ","
                new_line(out, indent, depth + 1)
                dump_into(out, &items[i], indent, depth + 1)
            if len(items) > 0:
                new_line(out, indent, depth)
            out += "]"
        case Value.Object(fields):
            out += "{"
            mut first: bool = True
            for key, item in fields.items():
                if not first:
                    out += ","
                first = False
                new_line(out, indent, depth + 1)
                dump_text(out, &key)
                out += ":"
                if indent > 0:
                    out += " "
                dump_into(out, &item, indent, depth + 1)
            if len(fields) > 0:
                new_line(out, indent, depth)
            out += "}"

# --- structs ---------------------------------------------------------------------------
# A struct is read from an object, and written as one: each field from the key of its name.
# A field can be a text, a number, a `bool`, a struct, a `vector`, a `dict` from texts, an
# `Optional` of them (absent or `null` is `None`), or a `Value`. A `managed enum` is the text
# of its case: `Mode.DryRun` is "dry-run". Keys that name no field are
# passed over.

# What a value of the wrong kind raises. Its reason starts with where it is, which each
# level adds in front as the error goes up: ".address.zip: expected a text".
priv manual fn refused(reason: &str) -> JsonError:
    return JsonError(line=0, column=0, reason=f": {reason}")

priv manual fn within(e: &JsonError, part: &str) -> JsonError:
    return JsonError(line=e.line, column=e.column, reason=f"{part}{e.reason}")

# Whether `slot` is an `Optional`, for a field whose type has no name here.
priv manual fn holds_optional[T](_slot: &T) -> bool:
    comptime if is_optional(T):
        return True
    else:
        return False

# Sets `out` to the case of the enum `T` that `value` names. Its cases carry no data.
priv manual fn fill_case[T](out: &mut T, value: &Value) raises JsonError:
    mut names: vector[str] = []
    comptime for v in variants(T):
        comptime for _f in fields(v):
            comptime assert(False, "json reads an enum whose cases carry no data")
        match value:
            case Value.Text(text):
                if text == v.name.kebab_case():
                    out = empty[T](v)
                    return
            case _:
                pass
        names.push(f"\"{v.name.kebab_case()}\"")
    raise refused(f"expected one of {", ".join(&names)}")

# Sets `out` from `value`.
priv manual fn fill[T](out: &mut T, value: &Value) raises JsonError:
    comptime if T == Value:
        out = value.copy()
    elif T == str:
        match value:
            case Value.Text(text):
                out = text.copy()
            case _:
                raise refused("expected a text")
    elif T == bool:
        match value:
            case Value.Bool(flag):
                out = flag
            case _:
                raise refused("expected true or false")
    elif T == f64:
        match value:
            case Value.Number(number):
                out = number
            case _:
                raise refused("expected a number")
    elif T == f32:
        match value:
            case Value.Number(number):
                out = f32(number)
            case _:
                raise refused("expected a number")
    elif is_int(T):
        match value:
            case Value.Number(number):
                if number > 9007199254740992.0 or number < -9007199254740992.0 or number != f64(i64(number)):
                    raise refused("expected a whole number")
                const fit: Optional[T] = T.checked(i64(number))
                if fit is None:
                    raise refused(f"{i64(number)} does not fit the field's type")
                out = fit
            case _:
                raise refused("expected a number")
    elif T == Optional:
        match value:
            case Value.Null:
                out = None
            case _:
                mut one: item(T) = empty[item(T)]()
                check fill(&mut one, value)
                out = one
    elif T == vector:
        match value:
            case Value.List(items):
                out.clear()
                for i in range(len(items)):
                    mut one: item(T) = empty[item(T)]()
                    try:
                        check fill(&mut one, &items[i])
                    except JsonError as e:
                        raise within(&e, f"[{i}]")
                    out.push(one)
            case _:
                raise refused("expected a list")
    elif T == dict:
        match value:
            case Value.Object(entries):
                out.clear()
                const names: vector[str] = entries.keys()
                for name in &names:
                    mut one: item(T) = empty[item(T)]()
                    try:
                        check fill(&mut one, &entries[name])
                    except JsonError as e:
                        raise within(&e, f".{name}")
                    out[name.copy()] = one
            case _:
                raise refused("expected an object")
    elif is_enum(T):
        check fill_case(out, value)
    elif is_struct(T):
        match value:
            case Value.Object(entries):
                comptime for f in fields(T):
                    if f.name in entries:
                        try:
                            check fill(&mut field(out, f), &entries[f.name])
                        except JsonError as e:
                            raise within(&e, f".{f.name}")
                    elif not holds_optional(&field(out, f)):
                        raise JsonError(line=0, column=0, reason=f".{f.name}: missing")
            case _:
                raise refused("expected an object")
    else:
        comptime assert(False, "json reads texts, numbers, `bool`, structs, enums, `vector`, `dict`, `Optional` and `Value`")

# `text` read as a `T`: a `Value` by default, `json.parse[User](text)` for a struct, or
# `json.parse[vector[User]](text)` for a list of them. What does not fit raises a
# `JsonError` whose reason says where: "users[2].age: expected a number".
manual fn parse[T = Value](text: &str) -> T raises JsonError:
    comptime if T == Value:
        return check parse_value(text)
    const value: Value = check parse_value(text)
    mut out: T = empty[T]()
    try:
        check fill(&mut out, &value)
    except JsonError as e:
        # The reason starts with ".name" or ": ": the mark in front goes.
        if e.reason.starts_with(": "):
            raise JsonError(line=e.line, column=e.column, reason=e.reason[2:])
        if e.reason.starts_with("."):
            raise JsonError(line=e.line, column=e.column, reason=e.reason[1:])
        raise e
    return out

# What is written in the file: a `Value`, or with `json.load[User](f)` a `User`, read as
# `parse` reads it.
manual fn load[T = Value](f: &File) -> T raises JsonError | IoError:
    const text: Optional[str] = check io.read(f, end="")
    if text is None:
        raise JsonError(line=1, column=1, reason="expected a value")
    return check parse[T](&text)

# `x` as a `Value`.
priv manual fn to_value[T](x: &T) -> Value:
    comptime if T == Value:
        return x.copy()
    elif T == str:
        return Value.Text(x.copy())
    elif T == bool:
        return Value.Bool(x)
    elif is_float(T) or is_int(T):
        return Value.Number(f64(x))
    elif T == Optional:
        const held: T = x.copy()
        if held is None:
            return Value.Null
        return to_value(&held)
    elif T == vector:
        mut items: vector[Value] = []
        for i in range(len(x)):
            items.push(to_value(&x[i]))
        return Value.List(items)
    elif T == dict:
        mut entries: dict[str, Value] = dict()
        const names: vector[str] = x.keys()
        for name in &names:
            entries[name.copy()] = to_value(&x[name])
        return Value.Object(entries)
    elif is_enum(T):
        comptime for v in variants(T):
            if x == empty[T](v):
                return Value.Text(v.name.kebab_case())
        return Value.Null
    elif is_struct(T):
        mut entries: dict[str, Value] = dict()
        comptime for f in fields(T):
            entries[f.name] = to_value(&field(x, f))
        return Value.Object(entries)
    else:
        comptime assert(False, "json writes texts, numbers, `bool`, structs, enums, `vector`, `dict`, `Optional` and `Value`")

# `value` as JSON text: on one line, or with `indent` spaces per level. `value` is a
# `Value`, or anything `parse` reads.
manual fn to_text[T](value: &T, indent: size = 0) -> str:
    mut out: str = ""
    comptime if T == Value:
        dump_into(&mut out, value, indent, 0)
    else:
        const made: Value = to_value(value)
        dump_into(&mut out, &made, indent, 0)
    return out

# Writes `value` as JSON, as `to_text` gives it.
manual fn dump[T](value: &T, to: &File = stdout, indent: size = 0):
    print(to_text(value, indent), to=to)

# url: takes a URL apart, and puts one together.
#
#     u = url.parse("https://example.com:8080/docs/a%20b?tag=x&tag=y#intro")
#     u.scheme         Scheme.Https
#     u.host           "example.com"
#     u.path           "/docs/a b"
#     u.query["tag"]   ['x', 'y']
#
# What a `Url` holds is decoded: `%20` is a space there, and `to_text` encodes it again.

# A port that is not a number, or is above 65535.
manual struct UrlError:
    text: str
    reason: str

# The scheme of a URL: `Http` and `Https` by name, any other as `Other`, `Other("mailto")`
# (in lowercase). `Relative` for a link written without one: "/about", "//cdn.example.com/a.js".
manual enum Scheme:
    Http
    Https
    Other(name: str)
    Relative

    # The scheme as a URL writes it: "https", "mailto"; "" for `Relative`.
    method name(&self) -> str:
        match self:
            case Scheme.Relative:
                return ""
            case Scheme.Http:
                return "http"
            case Scheme.Https:
                return "https"
            case Scheme.Other(name):
                return name.copy()

priv manual fn scheme_of(owned name: str) -> Scheme:
    if name == "http":
        return Scheme.Http
    if name == "https":
        return Scheme.Https
    return Scheme.Other(name)

# The parts of a URL. A part the URL does not have is "" (`Scheme.Relative` for the scheme,
# `None` for the port, no entry for the query). `user` is what comes before `@` in
# "https://ann@example.com".
manual struct Url:
    scheme: Scheme
    user: str
    host: str
    port: Optional[i32]
    path: str
    query: dict[str, vector[str]]
    fragment: str
    # The path as written, when encoding `path` again would not give it back: in
    # "/files/a%2Fb", `path` is "/files/a/b", and the `%2F` is one name, not a folder.
    # "" otherwise. `to_text` and `join` use it while `path` still decodes from it.
    raw_path: str

# --- characters -------------------------------------------------------------------------

priv manual fn is_letter(b: u8) -> bool:
    return (b >= 65 and b <= 90) or (b >= 97 and b <= 122)

priv manual fn is_digit(b: u8) -> bool:
    return b >= 48 and b <= 57

# Letters, digits, and `-._~`: what never needs encoding.
priv manual fn is_plain(b: u8) -> bool:
    return is_letter(b) or is_digit(b) or b == 45 or b == 46 or b == 95 or b == 126

# Whether `b` is one of the bytes of `kept`.
priv manual fn among(b: u8, kept: &str) -> bool:
    for i in range(byte_len(kept)):
        if kept.byte(i) == b:
            return True
    return False

priv manual fn hex_value(b: u8) -> Optional[u8]:
    if is_digit(b):
        return b - 48
    if b >= 97 and b <= 102:
        return b - 87
    if b >= 65 and b <= 70:
        return b - 55
    return None

priv manual fn hex_digit(n: u8) -> u8:
    if n < 10:
        return n + 48
    return n + 55

# Where `wanted` first is in `text`, from `start` and before `end`; `end` if it is not there.
priv manual fn position(text: &str, wanted: u8, start: size, end: size) -> size:
    for i in range(start, end):
        if text.byte(i) == wanted:
            return i
    return end

# `text` with every byte encoded as `%XX`, but the plain ones and those of `kept`.
priv manual fn encoded(text: &str, kept: &str) -> str:
    mut out: vector[u8] = []
    for i in range(byte_len(text)):
        const b: u8 = text.byte(i)
        if is_plain(b) or among(b, kept):
            out.push(b)
        else:
            out.push(37)
            out.push(hex_digit(b >> 4))
            out.push(hex_digit(b & 15))
    const made: Optional[str] = str.from_bytes(&out)
    if made is None:
        return ""
    return made

# `text` from `start` to `end`, with each `%XX` as the byte it stands for, and `+` as a space
# with `plus`. A `%` that is not followed by two hex digits stays; so does the whole piece,
# if what it would give is not UTF-8.
priv manual fn decoded(text: &str, start: size, end: size, plus: bool) -> str:
    mut out: vector[u8] = []
    mut i: size = start
    while i < end:
        const b: u8 = text.byte(i)
        mut taken: size = 1
        mut byte: u8 = b
        if b == 37 and i + 2 < end:
            const high: Optional[u8] = hex_value(text.byte(i + 1))
            const low: Optional[u8] = hex_value(text.byte(i + 2))
            if high is not None and low is not None:
                byte = high * 16 + low
                taken = 3
        elif b == 43 and plus:
            byte = 32
        out.push(byte)
        i += taken
    const made: Optional[str] = str.from_bytes(&out)
    if made is None:
        return text.byte_slice(start, end)
    return made

# The path of `u` as it is written in a URL.
priv manual fn path_text(u: &Url) -> str:
    if byte_len(u.raw_path) > 0 and decoded(&u.raw_path, 0, byte_len(u.raw_path), False) == u.path:
        return u.raw_path.copy()
    return encoded(&u.path, "/!$&'()*+,;=:@")

# Whether a path is written as a URL writes it: plain bytes, those a path keeps, and `%XX`.
priv manual fn well_encoded(raw: &str) -> bool:
    const n: size = byte_len(raw)
    mut i: size = 0
    while i < n:
        const b: u8 = raw.byte(i)
        if b == 37:
            if i + 2 >= n or hex_value(raw.byte(i + 1)) is None or hex_value(raw.byte(i + 2)) is None:
                return False
            i += 3
        elif is_plain(b) or among(b, "/!$&'()*+,;=:@"):
            i += 1
        else:
            return False
    return True

# Sets the path of `u` from how it is written, `raw`.
priv manual fn set_path(u: &mut Url, raw: &str):
    u.path = decoded(raw, 0, byte_len(raw), False)
    if not well_encoded(raw) or encoded(&u.path, "/!$&'()*+,;=:@") == raw:
        u.raw_path = ""
    else:
        u.raw_path = raw.copy()

# --- encode and decode ---------------------------------------------------------------------

# `text` made safe to put in a URL: every character but letters, digits and `-._~` becomes
# `%XX`. `url.encode("a b/c")` is "a%20b%2Fc".
manual fn encode(text: &str) -> str:
    return encoded(text, "")

# `text` with each `%XX` as the character it stands for: `url.decode("a%20b")` is "a b".
manual fn decode(text: &str) -> str:
    return decoded(text, 0, byte_len(text), False)

# The pairs of `fields` as a query or a form body writes them: `name=value`, joined by `&`,
# each encoded. A `dict[str, vector[str]]`, as `Url.query` is, writes a name once per value.
# `http.post(address, url.encode_form(&fields).bytes())` sends a form.
manual fn encode_form[V](fields: &dict[str, V]) -> str:
    mut out: str = ""
    for name, value in fields.items():
        comptime if V == vector:
            for one in &value:
                if byte_len(out) > 0:
                    out += "&"
                out += f"{encoded(&name, "")}={encoded(one, "")}"
        else:
            if byte_len(out) > 0:
                out += "&"
            out += f"{encoded(&name, "")}={encoded(&value, "")}"
    return out

# The pairs of a query or a form body, `a=1&b=2&b=3`, decoded, a `+` being a space: each name
# with its values in order, as `Url.query` holds them.
manual fn decode_form(text: &str) -> dict[str, vector[str]]:
    mut fields: dict[str, vector[str]] = dict()
    read_query(text, 0, byte_len(text), &mut fields)
    return fields

# --- parse -----------------------------------------------------------------------------------

# How many bytes the scheme of `text` takes, without its `:`; 0 if it has none.
priv manual fn scheme_len(text: &str) -> size:
    if byte_len(text) == 0 or not is_letter(text.byte(0)):
        return 0
    mut i: size = 1
    while i < byte_len(text):
        const b: u8 = text.byte(i)
        if b == 58:
            return i
        if not (is_letter(b) or is_digit(b) or b == 43 or b == 45 or b == 46):
            return 0
        i += 1
    return 0

# Adds the pairs of a query, `a=1&b=2`, which is in `text` from `first` to `last`.
priv manual fn read_query(text: &str, first: size, last: size, query: &mut dict[str, vector[str]]):
    mut start: size = first
    while start < last:
        const end: size = position(text, 38, start, last)
        if end > start:
            const equal: size = position(text, 61, start, end)
            const name: str = decoded(text, start, equal, True)
            mut value: str = ""
            if equal < end:
                value = decoded(text, equal + 1, end, True)
            if name not in query:
                query[name.copy()] = []
            query[name].push(value)
        start = end + 1

# The user, host and port: what is between `//` and the path, in `text` from `first` to `last`.
priv manual fn read_authority(text: &str, first: size, last: size, u: &mut Url) raises UrlError:
    mut start: size = first
    for i in range(first, last):
        if text.byte(i) == 64:
            u.user = decoded(text, first, i, False)
            start = i + 1
    mut port_at: size = last
    if start < last and text.byte(start) == 91:
        # An IPv6 address, in brackets: its `:` are not the port's.
        const close: size = position(text, 93, start, last)
        u.host = text.byte_slice(start + 1, close).lower()
        if close + 1 < last and text.byte(close + 1) == 58:
            port_at = close + 2
    else:
        const host_end: size = position(text, 58, start, last)
        u.host = decoded(text, start, host_end, False).lower()
        if host_end < last:
            port_at = host_end + 1
    if port_at < last:
        mut port: i32 = 0
        for i in range(port_at, last):
            const b: u8 = text.byte(i)
            if not is_digit(b) or port > 65535:
                raise UrlError(text=text.copy(), reason="the port is not a number up to 65535")
            port = port * 10 + i32(b - 48)
        if port > 65535:
            raise UrlError(text=text.copy(), reason="the port is not a number up to 65535")
        u.port = port

# The parts of the URL written in `text`.
manual fn parse(text: &str) -> Url raises UrlError:
    mut u: Url = Url(scheme=Scheme.Relative, user="", host="", port=None, path="", query=dict[str, vector[str]](), fragment="", raw_path="")
    const n: size = byte_len(text)
    mut at: size = 0
    const scheme: size = scheme_len(text)
    if scheme > 0:
        u.scheme = scheme_of(text.byte_slice(0, scheme).lower())
        at = scheme + 1
    const fragment_at: size = position(text, 35, at, n)
    const query_at: size = position(text, 63, at, fragment_at)
    if at + 1 < query_at and text.byte(at) == 47 and text.byte(at + 1) == 47:
        const end: size = position(text, 47, at + 2, query_at)
        check read_authority(text, at + 2, end, &mut u)
        at = end
    const raw: str = text.byte_slice(at, query_at)
    set_path(&mut u, &raw)
    if query_at < fragment_at:
        read_query(text, query_at + 1, fragment_at, &mut u.query)
    if fragment_at < n:
        u.fragment = decoded(text, fragment_at + 1, n, False)
    return u

# --- to_text -----------------------------------------------------------------------------

# The URL that `u` describes, with what needs it encoded.
manual fn to_text(u: &Url) -> str:
    mut out: str = ""
    if u.scheme != Scheme.Relative:
        out += u.scheme.name()
        out += ":"
    if len(u.host) > 0:
        out += "//"
        if len(u.user) > 0:
            out += encoded(&u.user, "!$&'()*+,;=:")
            out += "@"
        if u.host.contains(":"):
            out += f"[{u.host}]"
        else:
            out += encoded(&u.host, "")
        if u.port is not None:
            out += f":{u.port}"
    out += path_text(u)
    const query: str = encode_form(&u.query)
    if byte_len(query) > 0:
        out += "?"
        out += query
    if len(u.fragment) > 0:
        out += "#"
        out += encoded(&u.fragment, "/?!$&'()*+,;=:@")
    return out

# --- join --------------------------------------------------------------------------------

# `path` without its `.` and `..` parts: "/a/b/../c" is "/a/c".
priv manual fn without_dots(path: &str) -> str:
    const parts: vector[str] = path.split("/")
    mut kept: vector[str] = []
    mut open: bool = False
    for i in range(len(parts)):
        open = False
        if parts[i] == "..":
            if len(kept) > 1 or (len(kept) == 1 and len(kept[0]) > 0):
                kept.pop()
            open = True
        elif parts[i] == ".":
            open = True
        elif i == 0 or len(parts[i]) > 0 or i == len(parts) - 1:
            kept.push(parts[i].copy())
    if open:
        kept.push("")
    const joined: str = "/".join(&kept)
    if path.starts_with("/") and not joined.starts_with("/"):
        return "/" + joined
    return joined

# The URL that `link` leads to from the page at `base`, as a browser resolves it:
# from "https://example.com/a/b", "../c" leads to "https://example.com/c", "/d" to
# "https://example.com/d", and a whole URL to itself.
manual fn join(base: &Url, link: &str) -> Url raises UrlError:
    mut to: Url = check parse(link)
    # Paths are joined as they are written: an encoded `/` (`%2F`) is not a separator.
    mut raw: str = path_text(&to)
    if to.scheme != Scheme.Relative:
        const clean: str = without_dots(&raw)
        set_path(&mut to, &clean)
        return to
    to.scheme = base.scheme.copy()
    if len(to.host) > 0:
        const clean: str = without_dots(&raw)
        set_path(&mut to, &clean)
        return to
    to.user = base.user.copy()
    to.host = base.host.copy()
    to.port = base.port
    if len(raw) == 0:
        to.path = base.path.copy()
        to.raw_path = base.raw_path.copy()
        if len(to.query) == 0:
            to.query = base.query.copy()
        return to
    if not raw.starts_with("/"):
        # The link starts from the folder of the base's path.
        const base_raw: str = path_text(base)
        mut folder: size = 0
        for i in range(byte_len(base_raw)):
            if base_raw.byte(i) == 47:
                folder = i + 1
        if folder == 0 and len(base.host) > 0:
            raw = "/" + raw
        else:
            raw = base_raw.byte_slice(0, folder) + raw
    const clean: str = without_dots(&raw)
    set_path(&mut to, &clean)
    return to

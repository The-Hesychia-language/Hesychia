# elf: read an ELF file (executable, object, or shared library) into a structured form.
#
#     const data: vector[u8] = check fs.read_bytes("a.out")
#     const file: Elf = check elf.parse(&data)
#     for s in &file.symbols:
#         print(f"{s.value} {s.name}")
#
# `parse` is read-only. It reads the header, sections, segments and symbol tables of both 32-bit
# and 64-bit ELF in either byte order, widening every address and size to `u64`. Names are copied
# out, so the `Elf` owns its data and the input bytes can be dropped after parsing. Parsing is
# robust: it reads what it can for analysing hostile or malformed binaries, and only raises
# `ElfError` on a fatal problem (bad magic, a truncated header, a table past the end).
#
# `edit` opens an `Editor` for surgical changes to a copy of the bytes — set the entry point or a
# segment/section field, patch bytes, append data — then `build` emits the modified ELF.

from binary import Order, Width, BinaryError, read_u8, read_u16, read_u32, read_u64, put_u32, put_u64

# The kind of file: `e_type`. `Rel` is an object file, `Exec` an executable, `Dyn` a shared
# library or PIE, `Core` a core dump; anything else (including `ET_NONE`) is `Unknown`.
manual enum Kind:
    Rel
    Exec
    Dyn
    Core
    Unknown(value: u16)

# The target machine: `e_machine`. Only the common ones are named; the rest are `Unknown`.
manual enum Machine:
    X86
    X86_64
    Arm
    Aarch64
    RiscV
    Unknown(value: u16)

# A section's kind: `sh_type`.
manual enum SectionKind:
    Null
    ProgBits
    SymTab
    StrTab
    Rela
    Hash
    Dynamic
    Note
    NoBits
    Rel
    DynSym
    InitArray
    FiniArray
    Unknown(value: u32)

# A segment's kind: `p_type`.
manual enum SegmentKind:
    Null
    Load
    Dynamic
    Interp
    Note
    Phdr
    Tls
    GnuEhFrame
    GnuStack
    GnuRelro
    Unknown(value: u32)

# A symbol's binding: the high nibble of `st_info`.
manual enum Bind:
    Local
    Global
    Weak
    Unknown(value: u8)

# A symbol's type: the low nibble of `st_info`.
manual enum SymbolType:
    NoType
    Object
    Func
    Section
    File
    Common
    Tls
    Unknown(value: u8)

# Section flag bits, tested against `Section.flags`.
const SHF_WRITE: u64 = 1
const SHF_ALLOC: u64 = 2
const SHF_EXECINSTR: u64 = 4

# Segment flag bits, tested against `Segment.flags`.
const PF_X: u32 = 1
const PF_W: u32 = 2
const PF_R: u32 = 4

# The ELF header. `width` is the class (32- or 64-bit), `data` the byte order.
manual struct Header:
    width: Width
    data: Order
    kind: Kind
    machine: Machine
    entry: u64
    flags: u32
    phoff: u64
    phnum: u16
    shoff: u64
    shnum: u16
    shstrndx: u16

# A section header, with its name resolved.
manual struct Section:
    name: str
    kind: SectionKind
    flags: u64
    addr: u64
    offset: u64
    size: u64
    link: u32
    info: u32
    entsize: u64

# A program header (segment).
manual struct Segment:
    kind: SegmentKind
    flags: u32
    offset: u64
    vaddr: u64
    paddr: u64
    filesz: u64
    memsz: u64
    align: u64

# A symbol, with its name resolved.
manual struct Symbol:
    name: str
    value: u64
    size: u64
    bind: Bind
    kind: SymbolType
    shndx: u16

# A parsed ELF. `symbols` come from `.symtab`, `dynamic_symbols` from `.dynsym`; either is empty
# when its table is absent (a stripped binary has no `.symtab`, an object file no segments).
manual struct Elf:
    header: Header
    sections: vector[Section]
    segments: vector[Segment]
    symbols: vector[Symbol]
    dynamic_symbols: vector[Symbol]

# A fatal parse problem: `at` the byte offset, `reason` what was wrong.
manual struct ElfError:
    at: size
    reason: str

priv manual fn to_kind(v: i64) -> Kind:
    if v == 1:
        return Kind.Rel
    if v == 2:
        return Kind.Exec
    if v == 3:
        return Kind.Dyn
    if v == 4:
        return Kind.Core
    return Kind.Unknown(u16(v))

priv manual fn to_machine(v: i64) -> Machine:
    if v == 3:
        return Machine.X86
    if v == 62:
        return Machine.X86_64
    if v == 40:
        return Machine.Arm
    if v == 183:
        return Machine.Aarch64
    if v == 243:
        return Machine.RiscV
    return Machine.Unknown(u16(v))

priv manual fn to_section_kind(v: i64) -> SectionKind:
    if v == 0:
        return SectionKind.Null
    if v == 1:
        return SectionKind.ProgBits
    if v == 2:
        return SectionKind.SymTab
    if v == 3:
        return SectionKind.StrTab
    if v == 4:
        return SectionKind.Rela
    if v == 5:
        return SectionKind.Hash
    if v == 6:
        return SectionKind.Dynamic
    if v == 7:
        return SectionKind.Note
    if v == 8:
        return SectionKind.NoBits
    if v == 9:
        return SectionKind.Rel
    if v == 11:
        return SectionKind.DynSym
    if v == 14:
        return SectionKind.InitArray
    if v == 15:
        return SectionKind.FiniArray
    return SectionKind.Unknown(u32(v))

priv manual fn to_segment_kind(v: i64) -> SegmentKind:
    if v == 0:
        return SegmentKind.Null
    if v == 1:
        return SegmentKind.Load
    if v == 2:
        return SegmentKind.Dynamic
    if v == 3:
        return SegmentKind.Interp
    if v == 4:
        return SegmentKind.Note
    if v == 6:
        return SegmentKind.Phdr
    if v == 7:
        return SegmentKind.Tls
    if v == 1685382480:
        return SegmentKind.GnuEhFrame
    if v == 1685382481:
        return SegmentKind.GnuStack
    if v == 1685382482:
        return SegmentKind.GnuRelro
    return SegmentKind.Unknown(u32(v))

priv manual fn to_bind(v: i64) -> Bind:
    if v == 0:
        return Bind.Local
    if v == 1:
        return Bind.Global
    if v == 2:
        return Bind.Weak
    return Bind.Unknown(u8(v))

priv manual fn to_symbol_type(v: i64) -> SymbolType:
    if v == 0:
        return SymbolType.NoType
    if v == 1:
        return SymbolType.Object
    if v == 2:
        return SymbolType.Func
    if v == 3:
        return SymbolType.Section
    if v == 4:
        return SymbolType.File
    if v == 5:
        return SymbolType.Common
    if v == 6:
        return SymbolType.Tls
    return SymbolType.Unknown(u8(v))

# The null-terminated string at `base + index`, or "" when out of range or not UTF-8.
priv manual fn cstr(data: &vector[u8], base: size, index: size) -> str:
    const start: size = base + index
    if start >= len(data):
        return ""
    mut end: size = start
    while end < len(data) and data[end] != 0:
        end += 1
    mut bytes: vector[u8] = []
    for i in range(start, end):
        bytes.push(data[i])
    const text: Optional[str] = str.from_bytes(&bytes)
    if text is None:
        return ""
    return text

priv manual fn parse_segments(data: &vector[u8], width: Width, order: Order, phoff: u64, phnum: u16, phentsize: i64) -> vector[Segment] raises BinaryError:
    mut out: vector[Segment] = []
    if phoff == 0 or phnum == 0:
        return out
    mut stride: size = size(phentsize)
    if stride == 0:
        if width == Width.Bits64:
            stride = 56
        else:
            stride = 32
    mut i: size = 0
    while i < size(phnum):
        const base: size = size(phoff) + i * stride
        const ptype: i64 = check read_u32(data, base, order)
        mut pflags: i64 = 0
        mut poff: u64 = 0
        mut vaddr: u64 = 0
        mut paddr: u64 = 0
        mut filesz: u64 = 0
        mut memsz: u64 = 0
        mut align: u64 = 0
        if width == Width.Bits64:
            pflags = check read_u32(data, base + 4, order)
            poff = check read_u64(data, base + 8, order)
            vaddr = check read_u64(data, base + 16, order)
            paddr = check read_u64(data, base + 24, order)
            filesz = check read_u64(data, base + 32, order)
            memsz = check read_u64(data, base + 40, order)
            align = check read_u64(data, base + 48, order)
        else:
            poff = u64(check read_u32(data, base + 4, order))
            vaddr = u64(check read_u32(data, base + 8, order))
            paddr = u64(check read_u32(data, base + 12, order))
            filesz = u64(check read_u32(data, base + 16, order))
            memsz = u64(check read_u32(data, base + 20, order))
            pflags = check read_u32(data, base + 24, order)
            align = u64(check read_u32(data, base + 28, order))
        out.push(Segment(kind=to_segment_kind(ptype), flags=u32(pflags), offset=poff, vaddr=vaddr, paddr=paddr, filesz=filesz, memsz=memsz, align=align))
        i += 1
    return out

priv manual fn parse_sections(data: &vector[u8], width: Width, order: Order, shoff: u64, shnum: u16, shentsize: i64, shstrndx: u16) -> vector[Section] raises BinaryError:
    mut out: vector[Section] = []
    if shoff == 0 or shnum == 0:
        return out
    mut stride: size = size(shentsize)
    if stride == 0:
        if width == Width.Bits64:
            stride = 64
        else:
            stride = 40
    mut names: vector[i64] = []
    mut i: size = 0
    while i < size(shnum):
        const base: size = size(shoff) + i * stride
        const nameidx: i64 = check read_u32(data, base, order)
        const stype: i64 = check read_u32(data, base + 4, order)
        mut flags: u64 = 0
        mut addr: u64 = 0
        mut off: u64 = 0
        mut sz: u64 = 0
        mut link: i64 = 0
        mut info: i64 = 0
        mut entsize: u64 = 0
        if width == Width.Bits64:
            flags = check read_u64(data, base + 8, order)
            addr = check read_u64(data, base + 16, order)
            off = check read_u64(data, base + 24, order)
            sz = check read_u64(data, base + 32, order)
            link = check read_u32(data, base + 40, order)
            info = check read_u32(data, base + 44, order)
            entsize = check read_u64(data, base + 56, order)
        else:
            flags = u64(check read_u32(data, base + 8, order))
            addr = u64(check read_u32(data, base + 12, order))
            off = u64(check read_u32(data, base + 16, order))
            sz = u64(check read_u32(data, base + 20, order))
            link = check read_u32(data, base + 24, order)
            info = check read_u32(data, base + 28, order)
            entsize = u64(check read_u32(data, base + 36, order))
        out.push(Section(name="", kind=to_section_kind(stype), flags=flags, addr=addr, offset=off, size=sz, link=u32(link), info=u32(info), entsize=entsize))
        names.push(nameidx)
        i += 1
    const sidx: size = size(shstrndx)
    if sidx < len(out):
        const strbase: size = size(out[sidx].offset)
        mut j: size = 0
        while j < len(out):
            out[j].name = cstr(data, strbase, size(names[j]))
            j += 1
    return out

priv manual fn parse_symbols(data: &vector[u8], width: Width, order: Order, sections: &vector[Section], owned want: SectionKind) -> vector[Symbol]:
    mut out: vector[Symbol] = []
    mut tab: size = len(sections)
    mut k: size = 0
    while k < len(sections):
        if sections[k].kind == want:
            tab = k
        k += 1
    if tab == len(sections):
        return out
    mut strbase: size = 0
    const strsec: size = size(sections[tab].link)
    if strsec < len(sections):
        strbase = size(sections[strsec].offset)
    const symbase: size = size(sections[tab].offset)
    mut entsize: size = size(sections[tab].entsize)
    if entsize == 0:
        if width == Width.Bits64:
            entsize = 24
        else:
            entsize = 16
    const count: size = size(sections[tab].size) // entsize
    mut i: size = 0
    while i < count:
        const base: size = symbase + i * entsize
        if base + entsize > len(data):
            return out
        mut nameidx: i64 = 0
        mut info: i64 = 0
        mut shndx: i64 = 0
        mut value: u64 = 0
        mut sz: u64 = 0
        try:
            nameidx = check read_u32(data, base, order)
            if width == Width.Bits64:
                info = check read_u8(data, base + 4)
                shndx = check read_u16(data, base + 6, order)
                value = check read_u64(data, base + 8, order)
                sz = check read_u64(data, base + 16, order)
            else:
                value = u64(check read_u32(data, base + 4, order))
                sz = u64(check read_u32(data, base + 8, order))
                info = check read_u8(data, base + 12)
                shndx = check read_u16(data, base + 14, order)
        except BinaryError as _e:
            return out
        const name: str = cstr(data, strbase, size(nameidx))
        out.push(Symbol(name=name, value=value, size=sz, bind=to_bind(info // 16), kind=to_symbol_type(info % 16), shndx=u16(shndx)))
        i += 1
    return out

priv manual fn parse_body(data: &vector[u8], width: Width, order: Order) -> Elf raises BinaryError:
    const kind_v: i64 = check read_u16(data, 16, order)
    const machine_v: i64 = check read_u16(data, 18, order)
    mut entry: u64 = 0
    mut phoff: u64 = 0
    mut shoff: u64 = 0
    mut flags: i64 = 0
    mut phentsize: i64 = 0
    mut phnum: i64 = 0
    mut shentsize: i64 = 0
    mut shnum: i64 = 0
    mut shstrndx: i64 = 0
    if width == Width.Bits64:
        entry = check read_u64(data, 24, order)
        phoff = check read_u64(data, 32, order)
        shoff = check read_u64(data, 40, order)
        flags = check read_u32(data, 48, order)
        phentsize = check read_u16(data, 54, order)
        phnum = check read_u16(data, 56, order)
        shentsize = check read_u16(data, 58, order)
        shnum = check read_u16(data, 60, order)
        shstrndx = check read_u16(data, 62, order)
    else:
        entry = u64(check read_u32(data, 24, order))
        phoff = u64(check read_u32(data, 28, order))
        shoff = u64(check read_u32(data, 32, order))
        flags = check read_u32(data, 36, order)
        phentsize = check read_u16(data, 42, order)
        phnum = check read_u16(data, 44, order)
        shentsize = check read_u16(data, 46, order)
        shnum = check read_u16(data, 48, order)
        shstrndx = check read_u16(data, 50, order)
    const header: Header = Header(width=width, data=order, kind=to_kind(kind_v), machine=to_machine(machine_v), entry=entry, flags=u32(flags), phoff=phoff, phnum=u16(phnum), shoff=shoff, shnum=u16(shnum), shstrndx=u16(shstrndx))
    const segments: vector[Segment] = check parse_segments(data, width, order, phoff, u16(phnum), phentsize)
    const sections: vector[Section] = check parse_sections(data, width, order, shoff, u16(shnum), shentsize, u16(shstrndx))
    const symbols: vector[Symbol] = parse_symbols(data, width, order, &sections, SectionKind.SymTab)
    const dynamic: vector[Symbol] = parse_symbols(data, width, order, &sections, SectionKind.DynSym)
    return Elf(header=header, sections=sections, segments=segments, symbols=symbols, dynamic_symbols=dynamic)

# Parses `data` into an `Elf`. Raises `ElfError` on a fatal problem (bad magic, a truncated
# header, or a table pointing past the end of the data).
manual fn parse(data: &vector[u8]) -> Elf raises ElfError:
    if len(data) < 16:
        raise ElfError(at=0, reason="too small for an ELF header")
    if data[0] != 0x7f or data[1] != 0x45 or data[2] != 0x4c or data[3] != 0x46:
        raise ElfError(at=0, reason="not an ELF file (bad magic)")
    mut width: Width = Width.Bits64
    if data[4] == 1:
        width = Width.Bits32
    elif data[4] == 2:
        width = Width.Bits64
    else:
        raise ElfError(at=4, reason="unknown ELF class")
    mut order: Order = Order.Little
    if data[5] == 1:
        order = Order.Little
    elif data[5] == 2:
        order = Order.Big
    else:
        raise ElfError(at=5, reason="unknown ELF data encoding")
    try:
        return check parse_body(data, width, order)
    except BinaryError as e:
        raise ElfError(at=e.at, reason=e.reason.copy())

# The first section named `name`, or `None`.
manual fn find_section(file: &Elf, name: &str) -> Optional[Section]:
    for s in &file.sections:
        if s.name == name:
            return s.copy()
    return None

# The first symbol named `name`, searched in `.symtab` then `.dynsym`, or `None`.
manual fn find_symbol(file: &Elf, name: &str) -> Optional[Symbol]:
    for s in &file.symbols:
        if s.name == name:
            return s.copy()
    for s in &file.dynamic_symbols:
        if s.name == name:
            return s.copy()
    return None

# A field of a program header, for `Editor.set_segment_field`.
manual enum SegmentField:
    Type
    Flags
    Offset
    Vaddr
    Paddr
    FileSz
    MemSz
    Align

# A field of a section header, for `Editor.set_section_field`.
manual enum SectionField:
    Name
    Type
    Flags
    Addr
    Offset
    Size
    Link
    Info
    AddrAlign
    EntSize

# The byte offset within a program header, and the field's size in bytes, for this class.
priv manual fn seg_field(width: Width, field: SegmentField) -> (size, size):
    if width == Width.Bits64:
        match field:
            case SegmentField.Type:
                return (0, 4)
            case SegmentField.Flags:
                return (4, 4)
            case SegmentField.Offset:
                return (8, 8)
            case SegmentField.Vaddr:
                return (16, 8)
            case SegmentField.Paddr:
                return (24, 8)
            case SegmentField.FileSz:
                return (32, 8)
            case SegmentField.MemSz:
                return (40, 8)
            case SegmentField.Align:
                return (48, 8)
    match field:
        case SegmentField.Type:
            return (0, 4)
        case SegmentField.Offset:
            return (4, 4)
        case SegmentField.Vaddr:
            return (8, 4)
        case SegmentField.Paddr:
            return (12, 4)
        case SegmentField.FileSz:
            return (16, 4)
        case SegmentField.MemSz:
            return (20, 4)
        case SegmentField.Flags:
            return (24, 4)
        case SegmentField.Align:
            return (28, 4)

# The byte offset within a section header, and the field's size in bytes, for this class.
priv manual fn sec_field(width: Width, field: SectionField) -> (size, size):
    if width == Width.Bits64:
        match field:
            case SectionField.Name:
                return (0, 4)
            case SectionField.Type:
                return (4, 4)
            case SectionField.Flags:
                return (8, 8)
            case SectionField.Addr:
                return (16, 8)
            case SectionField.Offset:
                return (24, 8)
            case SectionField.Size:
                return (32, 8)
            case SectionField.Link:
                return (40, 4)
            case SectionField.Info:
                return (44, 4)
            case SectionField.AddrAlign:
                return (48, 8)
            case SectionField.EntSize:
                return (56, 8)
    match field:
        case SectionField.Name:
            return (0, 4)
        case SectionField.Type:
            return (4, 4)
        case SectionField.Flags:
            return (8, 4)
        case SectionField.Addr:
            return (12, 4)
        case SectionField.Offset:
            return (16, 4)
        case SectionField.Size:
            return (20, 4)
        case SectionField.Link:
            return (24, 4)
        case SectionField.Info:
            return (28, 4)
        case SectionField.AddrAlign:
            return (32, 4)
        case SectionField.EntSize:
            return (36, 4)

# Writes `value` as `count` (4 or 8) bytes at `at`, in `order`.
priv manual fn write_int(data: &mut vector[u8], at: size, value: u64, count: size, order: Order) raises ElfError:
    try:
        if count == 8:
            check put_u64(data, at, value, order)
        else:
            if value > u64(4294967295):
                raise ElfError(at=at, reason=f"{value} does not fit in 4 bytes")
            check put_u32(data, at, i64(value), order)
    except BinaryError as e:
        raise ElfError(at=e.at, reason=e.reason.copy())

# Surgical edits to a copy of an ELF's bytes: set fields, patch, append, then `build`.
manual struct Editor:
    priv bytes: vector[u8]
    priv width: Width
    priv order: Order
    priv phoff: size
    priv phentsize: size
    priv phnum: size
    priv shoff: size
    priv shentsize: size
    priv shnum: size
    header: Header
    sections: vector[Section]
    segments: vector[Segment]

    # Sets the entry point (`e_entry`).
    method set_entry(&mut self, addr: u64) raises ElfError:
        mut w: size = 4
        if self.width == Width.Bits64:
            w = 8
        const order: Order = self.order
        check write_int(&mut self.bytes, 24, addr, w, order)

    # Sets one field of segment `index`.
    method set_segment_field(&mut self, index: size, field: SegmentField, value: u64) raises ElfError:
        if index >= self.phnum:
            raise ElfError(at=0, reason=f"segment {index} is out of range")
        const (off, count): (size, size) = seg_field(self.width, field)
        const at: size = self.phoff + index * self.phentsize + off
        const order: Order = self.order
        check write_int(&mut self.bytes, at, value, count, order)

    # Sets one field of section `index`.
    method set_section_field(&mut self, index: size, field: SectionField, value: u64) raises ElfError:
        if index >= self.shnum:
            raise ElfError(at=0, reason=f"section {index} is out of range")
        const (off, count): (size, size) = sec_field(self.width, field)
        const at: size = self.shoff + index * self.shentsize + off
        const order: Order = self.order
        check write_int(&mut self.bytes, at, value, count, order)

    # Overwrites the bytes at `offset` with `data`.
    method patch(&mut self, offset: size, data: &vector[u8]) raises ElfError:
        if offset > len(self.bytes) or len(data) > len(self.bytes) - offset:
            raise ElfError(at=offset, reason="the patch goes past the end")
        for i in range(len(data)):
            self.bytes[offset + i] = data[i]

    # Overwrites 8 bytes at `offset` with `value`, in the ELF's byte order.
    method patch_u64(&mut self, offset: size, value: u64) raises ElfError:
        const order: Order = self.order
        check write_int(&mut self.bytes, offset, value, 8, order)

    # Overwrites 4 bytes at `offset` with `value`, in the ELF's byte order.
    method patch_u32(&mut self, offset: size, value: u64) raises ElfError:
        const order: Order = self.order
        check write_int(&mut self.bytes, offset, value, 4, order)

    # Appends `data` at the end, and gives the file offset where it starts.
    method append(&mut self, data: &vector[u8]) -> size:
        const at: size = len(self.bytes)
        for b in data:
            self.bytes.push(b)
        return at

    # The modified ELF. Consumes the editor.
    method build(owned self) -> vector[u8]:
        return self.bytes.copy()

# Opens an `Editor` over a copy of `data`, parsed to locate every field.
manual fn edit(owned data: vector[u8]) -> Editor raises ElfError:
    const parsed: Elf = check parse(&data)
    const width: Width = parsed.header.width
    const order: Order = parsed.header.data
    mut phentsize: size = 0
    mut shentsize: size = 0
    try:
        if width == Width.Bits64:
            phentsize = size(check read_u16(&data, 54, order))
            shentsize = size(check read_u16(&data, 58, order))
        else:
            phentsize = size(check read_u16(&data, 42, order))
            shentsize = size(check read_u16(&data, 46, order))
    except BinaryError as e:
        raise ElfError(at=e.at, reason=e.reason.copy())
    if phentsize == 0:
        if width == Width.Bits64:
            phentsize = 56
        else:
            phentsize = 32
    if shentsize == 0:
        if width == Width.Bits64:
            shentsize = 64
        else:
            shentsize = 40
    return Editor(bytes=data, width=width, order=order, phoff=size(parsed.header.phoff), phentsize=phentsize, phnum=size(parsed.header.phnum), shoff=size(parsed.header.shoff), shentsize=shentsize, shnum=size(parsed.header.shnum), header=parsed.header.copy(), sections=parsed.sections.copy(), segments=parsed.segments.copy())

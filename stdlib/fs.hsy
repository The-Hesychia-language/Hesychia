# fs: files and folders, named by their path.

from io import File, IoError, from_handle

@symbol("fopen")
priv extern fn c_fopen(path: ptr[u8], mode: ptr[u8]) -> Optional[ptr[u8]]
@symbol("remove")
priv extern fn c_remove(path: ptr[u8]) -> i32
@symbol("rmdir")
priv extern fn c_rmdir(path: ptr[u8]) -> i32
@symbol("hsy_rename")
priv extern fn c_rename(old: ptr[u8], new: ptr[u8]) -> i32
@symbol("access")
priv extern fn c_access(path: ptr[u8], mode: i32) -> i32
@symbol("mkdir")
priv extern fn c_mkdir(path: ptr[u8], mode: u32) -> i32
@symbol("mkdir")
priv extern fn win_mkdir(path: ptr[u8]) -> i32
@symbol("opendir")
priv extern fn c_opendir(path: ptr[u8]) -> Optional[ptr[u8]]
@symbol("readdir")
priv extern fn c_readdir(folder: ptr[u8]) -> Optional[ptr[u8]]
@symbol("closedir")
priv extern fn c_closedir(folder: ptr[u8]) -> i32
@symbol("hsy_path_kind")
priv extern fn path_kind(path: ptr[u8]) -> i32
@symbol("hsy_error_text")
priv extern fn error_text() -> ptr[u8]
@symbol("fread")
priv extern fn c_fread(data: ptr[u8], item: size, count: size, stream: ptr[u8]) -> size
@symbol("fwrite")
priv extern fn c_fwrite(data: ptr[u8], item: size, count: size, stream: ptr[u8]) -> size
@symbol("ferror")
priv extern fn c_ferror(stream: ptr[u8]) -> i32
@symbol("fclose")
priv extern fn c_fclose(stream: ptr[u8]) -> i32
@symbol("free")
priv extern fn c_free(memory: ptr[u8])
@symbol("hsy_stat")
priv extern fn c_stat(path: ptr[u8], follow: i32, out: ptr[i64]) -> i32
@symbol("hsy_create_new")
priv extern fn create_new(path: ptr[u8]) -> Optional[ptr[u8]]
@symbol("hsy_sync")
priv extern fn sync(stream: ptr[u8]) -> i32
@symbol("hsy_copy_mode")
priv extern fn copy_mode(path: ptr[u8], like: ptr[u8]) -> i32
@symbol("hsy_replace")
priv extern fn replace(old: ptr[u8], new: ptr[u8]) -> i32
@symbol("hsy_real_path")
priv extern fn real_path(path: ptr[u8]) -> Optional[ptr[u8]]

# What `kind` tests a path for.
manual enum Kind:
    File
    Dir
    Link

priv manual fn failure(path: &str) -> IoError:
    return IoError(path=f"{path}", reason=str.from_c(error_text()))

# How `open` opens a file: to read, to write from empty, or to add at the end.
manual enum Mode:
    Read
    Write
    Append

# Text is written with `print(..., to=f)` and read with `io.read(f)`.
manual fn open(path: &str, mode: Mode = Mode.Read) -> File raises IoError:
    # Binary mode keeps line breaks as they are on every system.
    mut flags: str = "rb"
    match mode:
        case Mode.Read:
            pass
        case Mode.Write:
            flags = "wb"
        case Mode.Append:
            flags = "ab"
    const handle: Optional[ptr[u8]] = c_fopen(path.to_c(), flags.to_c())
    if handle is None:
        raise failure(path)
    return from_handle(handle, path)

manual fn exists(path: &str) -> bool:
    return c_access(path.to_c(), 0) == 0

# Whether `path` is a file, a folder or a link: `fs.kind(path, fs.Kind.Dir)`.
manual fn kind(path: &str, wanted: Kind) -> bool:
    const found: i32 = path_kind(path.to_c())
    match wanted:
        case Kind.File:
            return found == 1
        case Kind.Dir:
            return found == 2
        case Kind.Link:
            return found == 3

# Whether the name of `path` ends with `.ext`; `ext` is written without the point, as "csv".
manual fn extension(path: &str, ext: &str) -> bool:
    const n: size = byte_len(path)
    const m: size = byte_len(ext)
    if m == 0 or n < m + 2:
        return False
    if path.byte(n - m - 1) != 46:
        return False
    for i in range(m):
        mut a: u8 = path.byte(n - m + i)
        mut b: u8 = ext.byte(i)
        if a >= 65 and a <= 90:
            a += 32
        if b >= 65 and b <= 90:
            b += 32
        if a != b:
            return False
    # Not a hidden file such as ".csv" alone.
    const before: u8 = path.byte(n - m - 2)
    return before != 47 and before != 92

# --- paths ---------------------------------------------------------------------
# Paths are joined with `/`, which Windows also takes; there `\` separates too.

priv manual fn is_separator(b: u8) -> bool:
    comptime if target.os == "windows":
        return b == 47 or b == 92
    else:
        return b == 47

# The bytes a path starts with that make it absolute: `/`, or on Windows `\`, `C:` or `C:\`.
priv manual fn root_len(path: &str) -> size:
    const n: size = byte_len(path)
    comptime if target.os == "windows":
        if n >= 2 and path.byte(1) == 58:
            const letter: u8 = path.byte(0) | 32
            if letter >= 97 and letter <= 122:
                if n >= 3 and is_separator(path.byte(2)):
                    return 3
                return 2
    if n >= 1 and is_separator(path.byte(0)):
        return 1
    return 0

# Where the last name of `path` starts and ends, separators at the end left out.
priv manual fn last_name(path: &str) -> (size, size):
    const root: size = root_len(path)
    mut end: size = byte_len(path)
    while end > root and is_separator(path.byte(end - 1)):
        end -= 1
    mut start: size = end
    while start > root and not is_separator(path.byte(start - 1)):
        start -= 1
    return (start, end)

priv manual fn bytes_between(path: &str, start: size, end: size) -> str:
    mut out: vector[u8] = []
    for i in range(start, end):
        out.push(path.byte(i))
    const text: Optional[str] = str.from_bytes(&out)
    if text is None:
        return ""
    return text

# `path` then `name`, with a `/` between them: `fs.join("data", "sales.csv")` is
# "data/sales.csv". A `name` that is absolute replaces `path`.
manual fn join(path: &str, name: &str) -> str:
    if byte_len(path) == 0 or root_len(name) > 0:
        return f"{name}"
    if byte_len(name) == 0 or is_separator(path.byte(byte_len(path) - 1)):
        return f"{path}{name}"
    return f"{path}/{name}"

# The last name of `path`: `fs.name("data/sales.csv")` is "sales.csv".
manual fn name(path: &str) -> str:
    const (start, end): (size, size) = last_name(path)
    return bytes_between(path, start, end)

# The name of `path` without its extension: `fs.stem("data/sales.csv")` is "sales". A name
# that starts with its only point, ".bashrc", has no extension.
manual fn stem(path: &str) -> str:
    const (start, end): (size, size) = last_name(path)
    mut cut: size = end
    while cut > start + 1 and path.byte(cut - 1) != 46:
        cut -= 1
    if cut > start + 1:
        return bytes_between(path, start, cut - 1)
    return bytes_between(path, start, end)

# The folder that holds `path`: `fs.parent("data/sales.csv")` is "data", "." for a name alone,
# and a root is its own parent.
manual fn parent(path: &str) -> str:
    const root: size = root_len(path)
    const (start, _): (size, size) = last_name(path)
    mut end: size = start
    while end > root and is_separator(path.byte(end - 1)):
        end -= 1
    if end == 0:
        return "."
    return bytes_between(path, 0, end)

# Where the name sits in a C `struct dirent`.
priv manual fn name_offset() -> size:
    comptime if target.os == "macos":
        return 21
    elif target.os == "windows":
        return 8
    else:
        return 19

# The paths of what a folder holds, without `.` and `..`, in no set order:
# `list_dir("data")` gives "data/sales.csv".
manual fn list_dir(path: &str) -> vector[str] raises IoError:
    const folder: Optional[ptr[u8]] = c_opendir(path.to_c())
    if folder is None:
        raise failure(path)
    mut prefix: str = f"{path}"
    if not prefix.ends_with("/") and not prefix.ends_with("\\"):
        prefix += "/"
    mut paths: vector[str] = []
    mut done: bool = False
    while not done:
        const entry: Optional[ptr[u8]] = c_readdir(folder)
        if entry is None:
            done = True
        else:
            const name: str = str.from_c(entry + name_offset())
            if name != "." and name != "..":
                paths.push(f"{prefix}{name}")
    c_closedir(folder)
    return paths

manual fn make_dir(path: &str) raises IoError:
    comptime if target.os == "windows":
        if win_mkdir(path.to_c()) != 0:
            raise failure(path)
    else:
        if c_mkdir(path.to_c(), 493) != 0:
            raise failure(path)

# Renames or moves `old` to `new`. A file already at `new` is replaced, on every system.
manual fn rename(old: &str, new: &str) raises IoError:
    if c_rename(old.to_c(), new.to_c()) != 0:
        raise failure(old)

# A file, or an empty folder; with `recursive=True`, a folder and all it holds.
manual fn remove(path: &str, recursive: bool = False) raises IoError:
    const folder: bool = kind(path, Kind.Dir)
    if recursive and folder:
        for inner in check list_dir(path):
            check remove(&inner, True)
    # Windows' `remove` takes files only.
    if folder:
        if c_rmdir(path.to_c()) != 0:
            raise failure(path)
    elif c_remove(path.to_c()) != 0:
        raise failure(path)

# --- bytes and information ------------------------------------------------------

# The whole content of the file at `path`. With a `limit`, a file larger than `limit` bytes
# raises `IoError` instead of filling the memory: a file from outside can be of any size.
manual fn read_bytes(path: &str, limit: Optional[size] = None) -> vector[u8] raises IoError:
    const handle: Optional[ptr[u8]] = c_fopen(path.to_c(), "rb".to_c())
    if handle is None:
        raise failure(path)
    mut data: vector[u8] = []
    mut chunk: vector[u8] = []
    for _ in range(65536):
        chunk.push(0)
    mut got: size = c_fread(ptr(&chunk[0]), 1, 65536, handle)
    while got > 0:
        if limit is not None and len(data) + got > limit:
            c_fclose(handle)
            raise IoError(path=f"{path}", reason=f"larger than the limit of {limit} bytes")
        for i in range(got):
            data.push(chunk[i])
        got = c_fread(ptr(&chunk[0]), 1, 65536, handle)
    # A folder opens on some systems, and fails here.
    const failed: bool = c_ferror(handle) != 0
    const reason: str = str.from_c(error_text())
    c_fclose(handle)
    if failed:
        raise IoError(path=f"{path}", reason=reason)
    return data

# Writes `bytes` and closes the file; with `flush_to_disk`, the bytes reach the disk first.
priv manual fn write_stream(handle: ptr[u8], path: &str, bytes: &vector[u8], flush_to_disk: bool) raises IoError:
    mut written: size = len(bytes)
    if len(bytes) > 0:
        written = c_fwrite(ptr(&bytes[0]), 1, len(bytes), handle)
    mut synced: bool = True
    if flush_to_disk and written == len(bytes):
        synced = sync(handle) == 0
    const reason: str = str.from_c(error_text())
    const closed: bool = c_fclose(handle) == 0
    if written != len(bytes) or not synced or not closed:
        raise IoError(path=f"{path}", reason=reason)

priv manual fn remove_quietly(path: &str):
    c_remove(path.to_c())

# The file a write to `path` changes: the target of a link, so that the link stays one.
priv manual fn write_target(path: &str) -> str:
    const found: Optional[ptr[u8]] = real_path(path.to_c())
    if found is None:
        return f"{path}"
    const target: str = str.from_c(found)
    c_free(found)
    return target

# Writes `bytes` as the whole content of the file at `path`, created if needed.
#
# By default the write is atomic: the bytes go to a new file beside it, which is written to
# the disk, given the permissions of the old one, then moved over it. Whoever reads `path`
# sees the old content or the new, never half of it, even if the program stops halfway.
# `atomic=False` writes into the file itself.
manual fn write_bytes(path: &str, bytes: &vector[u8], atomic: bool = True) raises IoError:
    if not atomic:
        const handle: Optional[ptr[u8]] = c_fopen(path.to_c(), "wb".to_c())
        if handle is None:
            raise failure(path)
        check write_stream(handle, path, bytes, False)
        return
    const target: str = write_target(path)
    const folder: str = parent(&target)
    const base: str = name(&target)
    # A name nobody else uses, created only if it does not exist yet.
    mut attempt: i64 = 0
    while True:
        const hidden: str = f".{base}.{attempt}.tmp"
        const temporary: str = join(&folder, &hidden)
        const handle: Optional[ptr[u8]] = create_new(temporary.to_c())
        if handle is not None:
            try:
                check write_stream(handle, &temporary, bytes, True)
            except IoError as e:
                remove_quietly(&temporary)
                raise IoError(path=f"{path}", reason=e.reason.copy())
            if copy_mode(temporary.to_c(), target.to_c()) != 0 or replace(temporary.to_c(), target.to_c()) != 0:
                const reason: IoError = failure(path)
                remove_quietly(&temporary)
                raise reason
            return
        # Only a name already taken (by a write that stopped halfway) is worth another try.
        # The reason is read first: testing the name changes it.
        const refusal: IoError = failure(path)
        if attempt >= 999 or not exists(&temporary):
            raise refusal
        attempt += 1

# What the file system knows of a file. Dates are in seconds since 1970, as
# `time.timestamp()` gives them, so `time.date(info.modified)` writes one.
manual struct Stat:
    size: i64
    kind: Kind
    modified: f64
    accessed: f64
    # The last change of the file's information (Unix `ctime`): `None` on Windows.
    changed: Optional[f64]
    # `None` where the file system does not record it, as on some Linux file systems.
    created: Optional[f64]

priv manual fn seconds(values: &vector[i64], at: size) -> f64:
    return f64(values[at]) + f64(values[at + 1]) / 1000000000.0

# The information of the file at `path`. With `follow=False`, a link is described itself
# instead of the file it points to, which is how a planted link is found.
manual fn stat(path: &str, follow: bool = True) -> Stat raises IoError:
    mut values: vector[i64] = []
    for _ in range(12):
        values.push(0)
    mut follow_flag: i32 = 0
    if follow:
        follow_flag = 1
    if c_stat(path.to_c(), follow_flag, ptr(&values[0])) != 0:
        raise failure(path)
    mut found: Kind = Kind.File
    if values[1] == 2:
        found = Kind.Dir
    elif values[1] == 3:
        found = Kind.Link
    mut changed: Optional[f64] = None
    if values[10] == 1:
        changed = seconds(&values, 6)
    mut created: Optional[f64] = None
    if values[11] == 1:
        created = seconds(&values, 8)
    return Stat(size=values[0], kind=found, modified=seconds(&values, 2), accessed=seconds(&values, 4), changed=changed, created=created)

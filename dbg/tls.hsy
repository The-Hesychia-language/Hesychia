from io import print
import io
import net
from thread import spawn
from io import File, stderr
from net import Listener

manual fn serve(owned listener: Listener, count: i64):
    for i in range(count):
        try:
            print(f"server: accepting {i}", to=stderr)
            const conn: File = check net.accept(&listener)
            print(f"server: accepted {i}", to=stderr)
            const line: Optional[str] = check io.read(&conn)
            if line is not None:
                print(f"secret {line}", to=conn)
            print(f"server: done {i}", to=stderr)
        except IoError as e:
            print(f"server: error {i}: {e.reason}", to=stderr)

managed fn main():
    quick = net.certificate("localhost")
    listener = net.listen_tls("127.0.0.1", 47251, quick, timeout=5.0)
    t = spawn(serve, listener, 3)
    for i in range(3):
        try:
            print(f"client: connecting {i}", to=stderr)
            conn = net.connect_tls("localhost", 47251, timeout=5.0, verify=False)
            print("hello", to=conn)
            answer = io.read(conn)
            if answer is not None:
                print(f"client: {answer}", to=stderr)
        except IoError as e:
            print(f"client: error {e.reason}", to=stderr)
    t.join()

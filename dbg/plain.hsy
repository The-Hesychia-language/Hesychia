from io import print
import io
import net
from thread import spawn
from io import File, stderr
from net import Listener

manual fn serve(owned listener: Listener):
    try:
        const conn: File = check net.accept(&listener)
        const a: Optional[str] = check io.read(&conn)
        print("one", to=conn)
        print("server: answered, closing", to=stderr)
    except IoError as e:
        print(f"server: {e.reason}", to=stderr)

managed fn main():
    listener = net.listen("127.0.0.1", 47280, timeout=5.0)
    t = spawn(serve, listener)
    conn = net.connect("127.0.0.1", 47280, timeout=5.0)
    print("hi", to=conn)
    print(f"client got {io.read(conn)}", to=stderr)
    t.join()
    print("client: server closed; writing again", to=stderr)
    try:
        print("again", to=conn)
        print("client: write ok; reading", to=stderr)
        r = io.read(conn)
        print(f"client: read {r}", to=stderr)
    except IoError as e:
        print(f"client: error [{e.reason}]", to=stderr)

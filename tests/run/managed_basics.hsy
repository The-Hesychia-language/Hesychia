from io import print

managed fn average(a: i64, b: i64) -> f64:
    total = a + b
    return f64(total) / 2.0

managed fn steps(limit: i32) -> i64:
    count = 0
    const big: i64 = 5000000000
    i = 0
    while i < limit:
        count += big
        i += 1
    return count

managed fn label(n: i32) -> str:
    text = "n="
    text = f"{text}{n}"
    return text

manual fn twice(x: i32) -> i32:
    return x * 2

managed fn narrow(x: i64) -> i32:
    return x

managed fn main():
    x = 3
    x = x + 1
    print(f"{x} {average(3, 4)} {steps(2)}")
    print(label(twice(21)))
    const small: u8 = 200
    wide = small + 1000
    print(f"{wide} {narrow(7)}")
# expect: 4 3.5 10000000000
# expect: n=42
# expect: 1200 7

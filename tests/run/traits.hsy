from io import print

trait Shape:
    method area(&self) -> f64
    method describe(&self) -> str:
        return f"shape of area {self.area()}"

manual struct Square(Shape):
    side: f64

    method area(&self) -> f64:
        return self.side * self.side

manual struct Circle(Shape):
    r: f64

    method area(&self) -> f64:
        return 3.0 * self.r * self.r

    method describe(&self) -> str:
        return f"circle of radius {self.r}"

manual struct Vec2(Add, Sub, Equal):
    x: i32
    y: i32

    method add(&self, other: &Vec2) -> Vec2:
        return Vec2(self.x + other.x, self.y + other.y)

    method sub(&self, other: &Self) -> Self:
        return Vec2(self.x - other.x, self.y - other.y)

    method equal(&self, other: &Vec2) -> bool:
        return self.x == other.x

manual struct Point:
    x: i32
    name: str

manual struct File(Drop):
    name: str

    method drop(&mut self):
        print(f"closing {self.name}")

manual fn keep(owned f: File) -> File:
    return f

manual fn main():
    const s: Square = Square(2.0)
    const c: Circle = Circle(1.0)
    print(s.describe())
    print(c.describe())
    mut v: Vec2 = Vec2(1, 2) + Vec2(10, 20)
    v += Vec2(100, 0)
    const w: Vec2 = v - Vec2(1, 1)
    print(f"{v.x} {v.y} {w.x} {w.y}")
    print(f"{Vec2(1, 2) == Vec2(1, 99)} {Vec2(1, 2) != Vec2(2, 2)}")
    const a: Point = Point(1, "a")
    print(f"{a == Point(1, "a")} {a == Point(1, "b")} {(1, "x") == (1, "x")} {[1, 2] == [1, 3]}")
    const f: File = File("log.txt")
    const _g: File = keep(f)
    if True:
        const _h: File = File("tmp")
    print("end")
# expect: shape of area 4.0
# expect: circle of radius 1.0
# expect: 111 22 110 21
# expect: True True
# expect: True False True False
# expect: closing tmp
# expect: end
# expect: closing log.txt

from io import print
import io
import net
import http
from thread import spawn
from io import File
from net import Listener

# What the test server answers for a path: the raw bytes of an HTTP answer.
manual fn answer_for(target: &str, request: &str) -> str:
    if target == "/page":
        return "HTTP/1.1 200 OK\r\nContent-Type: Text/HTML; charset=utf-8\r\nContent-Length: 13\r\nX-Twice: a\r\nx-twice: b\r\n\r\n<p>hello</p>\n"
    if target == "/chunked":
        return "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n4;ext=1\r\nWiki\r\n5\r\npedia\r\nB\r\n in\nchunks.\r\n0\r\nTrailer: x\r\n\r\n"
    if target == "/closed":
        return "HTTP/1.0 200 OK\r\n\r\nuntil the end"
    if target == "/missing":
        return "HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\n\r\n"
    if target == "/teapot":
        return "HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 418 I'm a teapot\r\nContent-Length: 0\r\n\r\n"
    if target == "/old":
        return "HTTP/1.1 301 Moved Permanently\r\nLocation: page\r\nContent-Length: 0\r\n\r\n"
    if target == "/form":
        return "HTTP/1.1 303 See Other\r\nLocation: /echo?after=post\r\nContent-Length: 0\r\n\r\n"
    if target == "/loop":
        return "HTTP/1.1 302 Found\r\nLocation: /loop\r\nContent-Length: 0\r\n\r\n"
    if target == "/big":
        return "HTTP/1.1 200 OK\r\nContent-Length: 10\r\n\r\n0123456789"
    if target == "/cut":
        return "HTTP/1.1 200 OK\r\nContent-Length: 100\r\n\r\nshort"
    if target == "/garbage":
        return "SSH-2.0-OpenSSH_9.6\r\n"
    return f"HTTP/1.1 200 OK\r\nContent-Length: {byte_len(request)}\r\n\r\n{request}"

# Serves `count` connections: reads the request head (and a body of `Content-Length`), answers.
manual fn serve(owned listener: Listener, count: i64):
    try:
        for _ in range(count):
            const conn: File = check net.accept(&listener)
            mut request: str = ""
            mut length: size = 0
            mut done: bool = False
            while not done:
                const line: Optional[str] = check io.read(&conn)
                if line is None or byte_len(line) == 0:
                    done = True
                else:
                    if line.lower().starts_with("content-length:"):
                        const value: str = line[15:len(line)]
                        const digits: str = value.strip()
                        length = size(check i64(digits))
                    request += line
                    request += "\n"
            if length > 0:
                const body: vector[u8] = check io.sys_read(&conn, length)
                const text: Optional[str] = str.from_bytes(&body)
                if text is not None:
                    request += text
            const parts: vector[str] = request.split(" ")
            mut target: str = parts[1].copy()
            if target.starts_with("/echo"):
                target = "/echo"
            const answer: str = answer_for(&target, &request)
            const bytes: vector[u8] = answer.bytes()
            check io.sys_write(&conn, &bytes)
    except IoError as e:
        print(f"server: {e.reason}")
    except ParseError as _e:
        print("server: bad length")

managed fn show(address: str):
    try:
        r = http.get(address)
        text = str.from_bytes(r.body)
        print(f"{http.code(r.status)} {r.status} [{http.media_type(r)}] {r.final_url}")
        if text is not None:
            print(f"[{text.strip()}]")
    except HttpError as e:
        print(f"error: {e.reason}")

managed fn main():
    listener = net.listen("127.0.0.1", 47240)
    t = spawn(serve, listener, 21)
    base = "http://127.0.0.1:47240"

    page = http.get(f"{base}/page")
    if page.status == http.Status.Ok:
        print("ok")
    twice = http.header(page, "X-TWICE")
    if twice is not None:
        print(twice)
    missing = http.header(page, "server")
    if missing is None:
        print("no server header")

    for path in ["/chunked", "/closed", "/missing", "/teapot", "/old", "/echo/a%20b?q=1#frag", "/loop", "/cut", "/garbage"]:
        show(f"{base}{path}")

    small = http.get(f"{base}/big", limit=50)
    print(f"{len(small.body)}")
    try:
        http.get(f"{base}/big", limit=5)
    except HttpError as e:
        print(f"error: {e.reason}")

    sent = http.post(f"{base}/echo", "q=tea%20%26%20cakes".bytes())
    echoed = str.from_bytes(sent.body)
    if echoed is not None:
        print(echoed)
    after = http.post(f"{base}/form", "x=1".bytes())
    redirected = str.from_bytes(after.body)
    if redirected is not None:
        lines = redirected.split("\n")
        print(f"{after.final_url} {lines[0]}")

    t.join()
    for bad in ["ftp://127.0.0.1/", "http:///nohost", "http://h:99999/"]:
        show(bad)
    print(f"{http.code(http.Status.Other(418))} {http.Status.NotFound}")

import fs
from io import print, IoError

manual fn within(path: &str) -> str:
    try:
        return check fs.join_within("out", path)
    except IoError as e:
        return f"refused ({e.reason})"

manual fn repeat(text: &str, count: size) -> str:
    mut out: str = ""
    for _ in range(count):
        out += text
    return out

manual fn main():
    # Paths and the start of a name.
    print(fs.sanitize_name("../../.bashrc"))
    print(fs.sanitize_name("C:\\evil\\run.exe"))
    print(fs.sanitize_name("-rf"))
    # Windows' forbidden characters, controls, and the end of a name.
    print(fs.sanitize_name("report final?.pdf"))
    print(fs.sanitize_name("a<b>c:d\"e|f*g"))
    print(fs.sanitize_name("red\u{1B}[31mtext"))
    print(fs.sanitize_name("name. . ."))
    # The reading-order trick: "invoice\u{202E}fdp.exe" shows as "invoiceexe.pdf".
    print(fs.sanitize_name("invoice\u{202E}fdp.exe"))
    # Windows devices, in any case, with an extension; look-alikes are left alone.
    print(f"{fs.sanitize_name("CON.txt")} {fs.sanitize_name("nul")} {fs.sanitize_name("com1.log")} {fs.sanitize_name("CON .txt")}")
    print(f"{fs.sanitize_name("COM10")} {fs.sanitize_name("console.txt")} {fs.sanitize_name("LPT¹")}")
    # Letters of every script stay; with ascii, they are replaced, one `_` each.
    print(f"{fs.sanitize_name("photo-été.jpg")} {fs.sanitize_name("写真.jpg")}")
    print(f"{fs.sanitize_name("photo-été.jpg", ascii=True)} {fs.sanitize_name("写真.jpg", ascii=True)}")
    # Nothing usable left.
    print(f"{fs.sanitize_name("")} {fs.sanitize_name("...")} {fs.sanitize_name("  ")} {fs.sanitize_name("", fallback="download")}")
    # Cut to 255 bytes, the extension kept, no character cut in two.
    const long_text: str = repeat("a", 300) + ".jpg"
    const wide_text: str = repeat("é", 200) + ".png"
    const long: str = fs.sanitize_name(&long_text)
    const wide: str = fs.sanitize_name(&wide_text)
    print(f"{byte_len(long)} {long.ends_with(".jpg")} {byte_len(wide) <= 255} {wide.ends_with("é.png")}")

    print(within("docs/a.txt"))
    print(within("docs\\a.txt"))
    print(within("docs/../a.txt"))
    print(within("./a//b/"))
    print(within(""))
    print(within("../a.txt"))
    print(within("a/../../b"))
    print(within("/etc/passwd"))
    print(within("\\\\server\\share\\x"))
    print(within("C:\\Windows\\x.dll"))
    print(within("c:x"))
    print(within("a/.. /b"))
    print(within("a/.../b"))
# expect: ___.._.bashrc
# expect: C__evil_run.exe
# expect: _rf
# expect: report final_.pdf
# expect: a_b_c_d_e_f_g
# expect: red_[31mtext
# expect: name
# expect: invoice_fdp.exe
# expect: _CON.txt _nul _com1.log _CON .txt
# expect: COM10 console.txt _LPT¹
# expect: photo-été.jpg 写真.jpg
# expect: photo-_t_.jpg __.jpg
# expect: file file file download
# expect: 255 True True True
# expect: out/docs/a.txt
# expect: out/docs/a.txt
# expect: out/a.txt
# expect: out/a/b
# expect: out
# expect: refused (`..` above the folder: it would not stay within the folder)
# expect: refused (`..` above the folder: it would not stay within the folder)
# expect: refused (an absolute path: it would not stay within the folder)
# expect: refused (an absolute path: it would not stay within the folder)
# expect: refused (a path on a drive: it would not stay within the folder)
# expect: refused (a path on a drive: it would not stay within the folder)
# expect: refused (a name of dots and spaces: it would not stay within the folder)
# expect: refused (a name of dots and spaces: it would not stay within the folder)

from io import print

managed fn main():
    pi = 3.14159
    n = 1234567
    name = "Ada"
    print(f"[{pi:.2f}] [{pi:8.3f}] [{pi:<8.1f}] [{-pi:+.1f}] [{pi:+.0f}]")
    print(f"[{n:,}] [{n:>12,}] [{n:012}] [{255:x}] [{255:X}] [{5:b}] [{8:o}] [{-42:5d}]")
    print(f"[{name:>6}] [{name:<6}] [{name:^7}] [{name:*^9}] [{name:2}]")
    print(f"[{0.256:.1%}] [{n:.1f}] [{1234.5:,.2f}] [{True:>6}] [{'x':3}]")
    print(f"[{u8(200):08b}] [{0:x}] [{i64(-255):x}] [{12345.678:.2e}]")
# expect: [3.14] [   3.142] [3.1     ] [-3.1] [+3]
# expect: [1,234,567] [   1,234,567] [000001234567] [ff] [FF] [101] [10] [  -42]
# expect: [   Ada] [Ada   ] [  Ada  ] [***Ada***] [Ada]
# expect: [25.6%] [1234567.0] [1,234.50] [  True] [x  ]
# expect: [11001000] [0] [-ff] [1.23e+04]

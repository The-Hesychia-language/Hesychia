from io import print
import io
import net
from thread import spawn
from io import File
from net import Listener, Certificate

# Answers each client with one line, `count` times; a client that fails the handshake is
# counted and the next one is waited for. Gives how many failed.
manual fn serve(owned listener: Listener, count: i64) -> i64:
    mut failed: i64 = 0
    for _ in range(count):
        try:
            const conn: File = check net.accept(&listener)
            const line: Optional[str] = check io.read(&conn)
            if line is not None:
                print(f"secret {line}", to=conn)
        except IoError as e:
            if e.reason.starts_with("TLS handshake failed"):
                failed += 1
    return failed

managed fn ask(port: i32, verify: bool, ca: Optional[Certificate]):
    try:
        conn = net.connect_tls("localhost", port, timeout=5.0, verify=verify, authority=ca)
        print("hello", to=conn)
        answer = io.read(conn)
        if answer is not None:
            print(answer)
    except IoError as e:
        print(f"client: {e.reason}")

managed fn main():
    ca = net.certificate("Hesychia Test CA", authority=True)
    server = net.certificate("localhost", names=["127.0.0.1"], signer=ca)
    other_ca = net.certificate("Other CA", authority=True, key=net.Key.Rsa)
    text = str.from_bytes(server.cert)
    if text is not None and text.starts_with("-----BEGIN CERTIFICATE-----"):
        print("pem")

    listener = net.listen_tls("127.0.0.1", 47250, server, timeout=5.0)
    t = spawn(serve, listener, 3)
    ask(47250, True, ca)
    ask(47250, True, other_ca)
    ask(47250, False, None)
    print(f"server: {t.join()} failed")

    quick = net.certificate("localhost")
    plain = net.listen_tls("127.0.0.1", 47251, quick, timeout=5.0)
    t2 = spawn(serve, plain, 1)
    ask(47251, False, None)
    t2.join()

    try:
        net.certificate("leaf", signer=server)
    except IoError as e:
        print(e.reason)
    mixed = Certificate(cert=server.cert, key=ca.key)
    try:
        net.listen_tls("127.0.0.1", 47252, mixed)
    except IoError as e:
        print(e.reason)
    try:
        net.load_certificate("/no/such/cert.pem", "/no/such/key.pem")
    except IoError as _e:
        print("no file")
# expect: pem
# expect: secret hello
# expect: client: certificate rejected: unable to get local issuer certificate
# expect: secret hello
# expect: server: 1 failed
# expect: secret hello
# expect: the signer is not an authority: make it with authority=True
# expect: the key does not go with the certificate
# expect: no file

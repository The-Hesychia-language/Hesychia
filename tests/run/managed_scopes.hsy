from io import print
from thread import scope

managed fn part_sum(values: vector[i64], start: i64, end: i64) -> i64:
    total = 0
    for i in range(start, end):
        total += values[i]
    return total

managed fn main():
    values = [i64(x) for x in range(1, 101)]
    with scope() as s:
        low = s.spawn(part_sum, values, 0, 50)
        high = s.spawn(part_sum, values, 50, 100)
        print(f"{low.join() + high.join()}")
# expect: 5050

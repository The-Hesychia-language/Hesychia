from io import print

manual struct Card(Order):
    rank: i32
    name: str

    method compare(&self, other: &Card) -> i32:
        return self.rank - other.rank

managed fn main():
    v = [5, 3, 8, 1, 3]
    v.sort()
    words = ["pear", "apple", "fig"]
    w = words.copy()
    w.sort()
    print(f"{v} {w} {words} {v.find(8)} {v.count(3)} {3 in v} {7 not in v}")
    v.reverse()
    v.extend([10, 20])
    print(f"{v} {v[1:3]} {v[:2]} {min(v)} {max(v)} {max(words)}")
    print(f"{min(4, 2)} {max("a", "b")} {sum([1, 2, 3])} {sum([1.5, 2.0])} {sum(words, "")}")
    cards = [Card(rank=3, name="c"), Card(rank=1, name="a"), Card(rank=3, name="b"), Card(rank=2, name="x")]
    cards.sort()
    names = [c.name for c in cards]
    print(f"{names}")
    empty = vector[i32]()
    print(f"{min(empty)} {sum(empty)}")
# expect: [1, 3, 3, 5, 8] ['apple', 'fig', 'pear'] ['pear', 'apple', 'fig'] 4 2 True True
# expect: [8, 5, 3, 3, 1, 10, 20] [5, 3] [8, 5] 1 20 'pear'
# expect: 2 b 6 3.5 pearapplefig
# expect: ['a', 'x', 'c', 'b']
# expect: None 0

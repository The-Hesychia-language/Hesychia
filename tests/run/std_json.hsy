import io
from io import print
import fs
import json
from json import Value

managed fn write(path: str, text: str):
    f = fs.open(path, fs.Mode.Write)
    print(text, end="", to=f)

managed fn load(text: str) -> Value:
    write("hsy-json-test.json", text)
    f = fs.open("hsy-json-test.json")
    return json.load(f)

managed fn main():
    v = load(" {\"name\": \"Ana\", \"tags\": [1, 2.5, true, null], \"esc\": \"a\\\"b\\u00e9\\ud83d\\ude00\\n\", \"empty\": {}} ")
    json.dump(v)
    json.dump(v, indent=2)
    match v:
        case Value.Object(fields):
            print(f"{fields.keys()} {len(fields)}")
            match fields["name"]:
                case Value.Text(name):
                    print(f"name {name}")
                case _:
                    print("?")
        case _:
            print("not an object")
    for bad in ["{\n  \"é\": tru\n}", "[1,", "{\"a\" 1}", "tru", "\"x", "1 2", "01", ""]:
        try:
            load(bad)
            print("accepted")
        except JsonError as e:
            print(f"{e.line}:{e.column}: {e.reason}")
    fs.remove("hsy-json-test.json")
    parsed = json.parse("[1, {\"a\": null}]")
    print(f"{json.to_text(parsed)} {json.to_text(json.parse("[]"), indent=2)}")
    try:
        json.parse("[1,")
    except JsonError as e:
        print(f"{e.line}:{e.column}: {e.reason}")

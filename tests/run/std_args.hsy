from io import print
import args

# Copies files, and counts what it copied.
managed struct Options:
    # The file to read
    source: str
    # Where to write it
    target: str
    # How many times to try again
    retries: i64 = 3
    # Say what is being done
    verbose: bool = False
    # Write a report to this file
    report: Optional[str]
    dry_run: bool = False

manual struct Sum:
    # How much each number counts
    scale: f64 = 1.0
    limit: Optional[u8]
    # The numbers to add
    numbers: vector[i32]

# A tool with commands.
manual enum Command:
    # Build the project
    Build(release: bool = False, jobs: i64 = 4)
    # Run a file,
    # then wait.
    Run(path: str, watch: bool = False)
    DryRun

managed fn copy(words: vector[str]):
    try:
        o = args.parse[Options](words)
        print(f"{o.source} {o.target} {o.retries} {o.verbose} {o.report} {o.dry_run}")
    except ArgsError as e:
        print(f"error: {e.reason}")

managed fn command(words: vector[str]):
    try:
        match args.parse[Command](words):
            case Command.Build(release, jobs):
                print(f"build {release} {jobs}")
            case Command.Run(path, watch):
                print(f"run {path} {watch}")
            case Command.DryRun:
                print("dry run")
    except ArgsError as e:
        print(f"error: {e.reason}")

managed fn main():
    copy(["a.txt", "b.txt"])
    copy(["--retries", "5", "a.txt", "--verbose", "b.txt", "--report=out.md", "--dry-run"])
    copy(["--", "--a", "-b"])
    copy(["a.txt"])
    copy(["a", "b", "c"])
    copy(["a", "b", "--retries", "many"])
    copy(["a", "b", "--retries"])
    copy(["a", "b", "--color", "red"])
    copy(["a", "b", "--verbose=yes"])
    copy(["a", "b", "-v"])
    sum = args.parse[Sum](["1", "-2", "30", "--limit", "9", "--scale", "0.5"])
    print(f"{sum.numbers} {sum.limit} {sum.scale}")
    try:
        args.parse[Sum](["--limit", "300"])
    except ArgsError as e:
        print(f"error: {e.reason}")
    command(["build"])
    command(["build", "--release", "--jobs", "8"])
    command(["run", "main.hsy", "--watch"])
    command(["dry-run"])
    command(["run"])
    command(["deploy"])
    command(vector[str]())
    print(args.help[Options]("copy").replace("\n\n", "\n.\n"))
    print(args.help[Sum]("sum").replace("\n\n", "\n.\n"))
    print(args.help[Command]("tool").replace("\n\n", "\n.\n"))
    print(args.help[Command]("tool", "run").replace("\n\n", "\n.\n"))
# expect: a.txt b.txt 3 False None False
# expect: a.txt b.txt 5 True 'out.md' True
# expect: --a -b 3 False None False
# expect: error: <target> is missing
# expect: error: unexpected `c`
# expect: error: --retries: `many`: not a whole number
# expect: error: `--retries` needs a value
# expect: error: unknown option `--color`
# expect: error: `--verbose` takes no value
# expect: error: unknown option `-v`
# expect: [1, -2, 30] 9 0.5
# expect: error: --limit: `300`: too large
# expect: build False 4
# expect: build True 8
# expect: run main.hsy True
# expect: dry run
# expect: error: <path> is missing
# expect: error: unknown command `deploy`
# expect: error: a command is missing

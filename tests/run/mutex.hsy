from io import print
from thread import mutex, scope

manual struct Stats:
    count: i64
    names: vector[str]

manual fn record(stats: &mutex[Stats], name: &str):
    with stats as s:
        s.count += 1
        s.names.push(name.copy())

manual fn first_long(words: &mutex[vector[str]]) -> size:
    with words as w:
        for word in w:
            if len(word) > 3:
                return len(word)
    return 0

managed fn main():
    total = mutex(0)
    parallel for i in range(1000):
        with total as n:
            n += i
    with total as n:
        print(f"{n}")
    stats = mutex(Stats(0, []))
    with scope() as s:
        s.spawn(record, stats, "a")
        s.spawn(record, stats, "b")
    with stats as st:
        st.names.sort()
        print(f"{st.count} {st.names}")
    words = mutex(["a", "pears"])
    print(f"{first_long(words)}")
    with words as w:
        w.push("fig")
        print(f"{len(w)}")
# expect: 499500
# expect: 2 ['a', 'b']
# expect: 5
# expect: 3

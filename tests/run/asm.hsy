from io import print

comptime if target.arch == "x86_64":
    manual fn add(a: u64, b: u64) -> u64:
        mut sum: u64 = a
        asm(inout("rax") sum, in("rcx") b, clobber("rdx")):
            "add rax, rcx"
        return sum

    manual fn cycles_move() -> bool:
        mut lo: u32 = 0
        mut hi: u32 = 0
        asm(out("eax") lo, out("edx") hi):
            "rdtsc"
        return (u64(hi) << 32) | u64(lo) > 0
else:
    manual fn add(a: u64, b: u64) -> u64:
        return a + b

    manual fn cycles_move() -> bool:
        return True

manual fn main():
    print(f"{add(40, 2)} {cycles_move()}")
# expect: 42 True

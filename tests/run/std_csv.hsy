import io
from io import print
import fs
import csv

managed fn write(path: str, text: str):
    f = fs.open(path, fs.Mode.Write)
    print(text, end="", to=f)

managed fn main():
    write("hsy-csv-test.csv", "name,city,note\nana,Paris,\"says \"\"hi\"\"\"\nbob,\"Lyon, FR\",\"two\nlines\"\n")
    f = fs.open("hsy-csv-test.csv")
    rows = csv.load[vector](f)
    io.close(f)
    print(f"{len(rows)} {rows[1]} {rows[2][1]}")
    g = fs.open("hsy-csv-test.csv")
    people = csv.load[dict](g)
    io.close(g)
    print(f"{people[0]["city"]} {people[1]["note"].replace("\n", "|")}")
    csv.dump(rows)
    csv.dump(people, sep=";")
    write("hsy-csv-test.csv", "a,\"b")
    h = fs.open("hsy-csv-test.csv")
    try:
        csv.load[vector](h)
    except CsvError as e:
        print(f"line {e.line}: {e.reason}")
    io.close(h)
    fs.remove("hsy-csv-test.csv")
    table = csv.parse[vector]("x;y\n1;\"a;b\"\n", sep=";")
    print(f"{table}")
    named = csv.parse[dict]("id,name\r\n7,Zoé\r\n")
    nothing = csv.parse[vector]("")
    print(f"{named[0]["name"]} {len(nothing)}")
    print(csv.to_text(table), end="")
    print(csv.to_text(named, sep="|"), end="")
    for text in ["a,\n", "x\r\n\r\ny\r\n", "\"a\"b,c", "ab\"c", "\"é,\"\"\",ü\n"]:
        try:
            print(f"{csv.parse[vector](text)}")
        except CsvError as e:
            print(f"line {e.line}: {e.reason}")

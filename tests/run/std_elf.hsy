from io import print
from binary import Order, push_u16, push_u32, push_u64
from elf import parse, edit, find_section, find_symbol

managed fn p16(out: vector[u8], v: i64, order: Order):
    push_u16(out, v, order)

managed fn p32(out: vector[u8], v: i64, order: Order):
    push_u32(out, v, order)

managed fn p64(out: vector[u8], v: i64, order: Order):
    push_u64(out, u64(v), order)

managed fn name_push(out: vector[u8], text: str):
    i = 0
    while i < byte_len(text):
        out.push(text.byte(i))
        i += 1
    out.push(u8(0))

managed fn phdr(out: vector[u8], ptype: i64, flags: i64, off: i64, vaddr: i64, filesz: i64, memsz: i64, align: i64, order: Order):
    p32(out, ptype, order)
    p32(out, flags, order)
    p64(out, off, order)
    p64(out, vaddr, order)
    p64(out, vaddr, order)
    p64(out, filesz, order)
    p64(out, memsz, order)
    p64(out, align, order)

managed fn sym(out: vector[u8], name: i64, info: i64, shndx: i64, value: i64, sz: i64, order: Order):
    p32(out, name, order)
    out.push(u8(info))
    out.push(u8(0))
    p16(out, shndx, order)
    p64(out, value, order)
    p64(out, sz, order)

managed fn shdr(out: vector[u8], name: i64, stype: i64, off: i64, sz: i64, link: i64, info: i64, align: i64, entsize: i64, order: Order):
    p32(out, name, order)
    p32(out, stype, order)
    p64(out, 0, order)
    p64(out, 0, order)
    p64(out, off, order)
    p64(out, sz, order)
    p32(out, link, order)
    p32(out, info, order)
    p64(out, align, order)
    p64(out, entsize, order)

# A minimal 64-bit ELF: header, one PT_LOAD, and .shstrtab/.symtab/.strtab with one symbol.
managed fn build() -> vector[u8]:
    order = Order.Little
    out = vector[u8]()
    for b in [0x7f, 0x45, 0x4c, 0x46, 2, 1, 1]:
        out.push(u8(b))
    for _ in range(9):
        out.push(u8(0))
    p16(out, 2, order)
    p16(out, 62, order)
    p32(out, 1, order)
    p64(out, 0x401000, order)
    p64(out, 64, order)
    p64(out, 208, order)
    p32(out, 0, order)
    p16(out, 64, order)
    p16(out, 56, order)
    p16(out, 1, order)
    p16(out, 64, order)
    p16(out, 4, order)
    p16(out, 1, order)
    phdr(out, 1, 5, 0, 0x400000, 0x1000, 0x1000, 0x1000, order)
    out.push(u8(0))
    name_push(out, ".shstrtab")
    name_push(out, ".symtab")
    name_push(out, ".strtab")
    out.push(u8(0))
    name_push(out, "main")
    while len(out) < 160:
        out.push(u8(0))
    sym(out, 0, 0, 0, 0, 0, order)
    sym(out, 1, 0x12, 1, 0x401000, 0x20, order)
    while len(out) < 208:
        out.push(u8(0))
    for _ in range(64):
        out.push(u8(0))
    shdr(out, 1, 3, 120, 27, 0, 0, 1, 0, order)
    shdr(out, 11, 2, 160, 48, 3, 1, 8, 24, order)
    shdr(out, 19, 3, 147, 6, 0, 0, 1, 0, order)
    return out

managed fn main():
    data = build()
    file = parse(data)
    print(f"{file.header.entry:x} {file.header.kind} {file.header.machine} {file.header.width}")
    print(f"segs={len(file.segments)} secs={len(file.sections)} syms={len(file.symbols)}")
    s = find_section(file, ".symtab")
    if s is not None:
        print(f"found {s.name} off={s.offset} link={s.link}")
    m = find_symbol(file, "main")
    if m is not None:
        print(f"main {m.value:x} {m.kind} {m.bind}")
    ed = edit(data)
    ed.set_entry(0x402000)
    extra = vector[u8]()
    for _ in range(4):
        extra.push(u8(0x90))
    at = ed.append(extra)
    out = ed.build()
    re = parse(out)
    print(f"edited entry={re.header.entry:x} at={at} newlen={len(out)}")
# expect: 401000 Kind.Exec Machine.X86_64 Width.Bits64
# expect: segs=1 secs=4 syms=2
# expect: found .symtab off=160 link=3
# expect: main 401000 SymbolType.Func Bind.Global
# expect: edited entry=402000 at=464 newlen=468
